---
/**
 * SectionLabel — the tiny section index + name (Section 21).
 * e.g.  01 — THE EXPERIENCE.  Subtle, muted champagne. Never a case-study badge.
 */
interface Props {
  index?: string;
  class?: string;
  [key: string]: unknown;
}
const { index, class: className, ...rest } = Astro.props;
---

<p class={["section-label", className].filter(Boolean).join(" ")} {...rest}>
  {index && <span class="section-label__index">{index}</span>}
  <span class="section-label__text"><slot /></span>
</p>

<style>
  .section-label {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-12);
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    max-width: none;
  }

  .section-label__index {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
</style>
