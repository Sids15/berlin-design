---
/**
 * Button — rectangular, never a pill (Section 12).
 * variant: "primary" (1px border, subtle hover fill) | "secondary" (borderless, arrow).
 * Renders an <a> when `href` is given, otherwise a real <button> for semantics.
 */
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  arrow?: boolean;
  type?: "button" | "submit";
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  arrow = true,
  type = "button",
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "button";
const classes = ["btn", `btn--${variant}`, className].filter(Boolean).join(" ");
---

<Tag
  class={classes}
  {...href ? { href } : { type }}
  {...rest}
>
  <span class="btn__label"><slot /></span>
  {arrow && (
    <svg
      class="btn__arrow"
      width="36"
      height="8"
      viewBox="0 0 36 8"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M0 4h34M34 4l-5-3.25M34 4l-5 3.25"
        stroke="currentColor"
        stroke-width="1"
        stroke-linecap="square"
      />
    </svg>
  )}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-16);
    min-height: var(--btn-height);
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out), border-color 0.4s var(--ease-out);
  }

  .btn__arrow {
    transition: transform 0.4s var(--ease-out);
  }

  .btn:hover .btn__arrow {
    transform: translateX(4px);
  }

  /* Primary — bordered, fills subtly on hover */
  .btn--primary {
    padding-inline: var(--btn-padding-inline);
    border: 1px solid var(--accent);
    color: var(--text-strong);
    background-color: color-mix(in srgb, var(--accent) 88%, transparent);
  }

  .btn--primary .btn__label {
    color: var(--color-void);
  }

  .btn--primary:hover,
  .btn--primary:focus-visible {
    background-color: var(--color-void);
    border-color: var(--accent);
  }

  .btn--primary:hover .btn__label,
  .btn--primary:focus-visible .btn__label {
    color: var(--accent);
  }

  /* Secondary — no border, arrow-led */
  .btn--secondary {
    padding-inline: 0;
    color: var(--text);
    background: none;
  }

  .btn--secondary:hover,
  .btn--secondary:focus-visible {
    color: var(--accent);
  }
</style>
