---
/**
 * SectionIndex — the right-hand vertical progress rail (reference hero).
 * Lists the eight journey stops (Section 21) and highlights the one at the
 * centre of the viewport as the visitor scrolls, doubling as the day→night
 * progress indicator. Desktop-only; hidden on smaller screens per §24.
 *
 * The scroll-sync is a tiny IntersectionObserver — not a React island. It
 * observes only the journey sections that currently exist, so it stays
 * correct as sections are added feature by feature.
 */
import { journey } from "../../data/site";
---

<nav class="section-index" aria-label="Page sections">
  <ol class="section-index__list">
    {journey.map((stop, i) => (
      <li class="section-index__item">
        <a
          class:list={["section-index__link", { "is-active": i === 0 }]}
          href={`#${stop.id}`}
          data-journey-link={stop.id}
        >
          <span class="section-index__dot" aria-hidden="true"></span>
          <span class="section-index__num">{stop.index}</span>
          <span class="visually-hidden">{stop.label}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLElement>("[data-journey-link]")
  );
  const byId = new Map(links.map((l) => [l.dataset.journeyLink, l]));

  const setActive = (id: string | undefined) => {
    if (!id || !byId.has(id)) return;
    links.forEach((l) => l.classList.remove("is-active"));
    byId.get(id)!.classList.add("is-active");
  };

  // Activate a journey stop when its section crosses the middle band.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) setActive(entry.target.id);
      }
    },
    { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
  );

  document
    .querySelectorAll<HTMLElement>("[data-journey-section]")
    .forEach((section) => observer.observe(section));

  // Hide the rail once the footer comes into view — the journey is over, and
  // it should never float over the light footer panel.
  const rail = document.querySelector<HTMLElement>(".section-index");
  const footer = document.querySelector<HTMLElement>(".brandfoot");
  if (rail && footer) {
    new IntersectionObserver(
      ([entry]) => rail.classList.toggle("is-hidden", entry.isIntersecting),
      { threshold: 0 }
    ).observe(footer);
  }
</script>

<style>
  .section-index {
    position: fixed;
    inset-inline-end: clamp(1rem, 2.4vw, 2.75rem);
    inset-block-start: 50%;
    transform: translateY(-50%);
    z-index: var(--z-header);
    transition: opacity 0.5s var(--ease-out);
  }

  .section-index.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .section-index__list {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.4vh, 1.35rem);
  }

  .section-index__link {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    color: var(--color-muted-ivory);
    opacity: 0.55;
    transition: opacity 0.4s var(--ease-out), color 0.4s var(--ease-out);
  }

  .section-index__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: transparent;
    transition: background-color 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .section-index__num {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    font-variant-numeric: tabular-nums;
    /* Numbers hidden by default; the active stop reveals its own. */
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .section-index__link:hover,
  .section-index__link:focus-visible {
    opacity: 1;
    color: var(--color-white);
  }

  .section-index__link:hover .section-index__num,
  .section-index__link:focus-visible .section-index__num {
    opacity: 1;
    transform: translateX(0);
  }

  .section-index__link.is-active {
    opacity: 1;
    color: var(--color-white);
  }

  .section-index__link.is-active .section-index__dot {
    background: currentColor;
    transform: scale(1.15);
  }

  .section-index__link.is-active .section-index__num {
    opacity: 1;
    transform: translateX(0);
  }

  /* Desktop-only rail (§24) */
  @media (max-width: 64rem) {
    .section-index {
      display: none;
    }
  }
</style>
