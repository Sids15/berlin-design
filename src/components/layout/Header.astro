---
/**
 * Header (Section 13) — transparent over the hero, dark-translucent once
 * scrolled. No blur wall; just a darkened background, as the spec asks.
 * The scroll-state toggle is a few lines of vanilla JS, not a React island.
 * The full mobile nav drawer arrives in a later feature; for now mobile
 * shows the wordmark and a working Reserve action.
 */
import { brand, nav } from "../../data/site";
import Button from "../ui/Button.astro";
---

<header class="site-header" data-header>
  <div class="site-header__inner container--xl">
    <a class="wordmark" href="#top" aria-label={`${brand.name}, ${brand.tagline} — home`}>
      <span class="wordmark__name">{brand.name}</span>
      <span class="wordmark__tagline">{brand.tagline}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li><a class="site-nav__link" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__cta">
      <Button href="#visit" variant="primary" arrow={false}>Reserve a Table</Button>
    </div>
  </div>
</header>

<script>
  // Toggle the scrolled state once the visitor leaves the hero.
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 24);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-header);
    transition: background-color 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out);
    border-block-end: 1px solid transparent;
  }

  .site-header.is-scrolled {
    background-color: rgba(9, 9, 8, 0.86);
    border-block-end-color: var(--border-subtle);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-32);
    min-height: 5rem;
    padding-inline: var(--gutter);
    margin-inline: auto;
  }

  /* --- Wordmark (Section 14) — plain, no glow, no gradient ----------------- */
  .wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
    color: var(--text-strong);
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.14em;
  }

  .wordmark__tagline {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    color: var(--text-muted);
    margin-block-start: 0.35rem;
  }

  /* --- Nav ---------------------------------------------------------------- */
  .site-nav__list {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .site-nav__link {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--text);
    padding-block: var(--space-8);
    position: relative;
    transition: color 0.35s var(--ease-out);
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: var(--accent);
  }

  .site-nav__link:hover::after,
  .site-nav__link:focus-visible::after {
    transform: scaleX(1);
  }

  /* --- Responsive: hide the inline nav until the drawer feature lands ------ */
  @media (max-width: 60rem) {
    .site-nav {
      display: none;
    }
    .site-header__inner {
      min-height: 4.5rem;
    }
  }
</style>
