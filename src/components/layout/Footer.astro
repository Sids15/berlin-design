---
/**
 * Footer (§20) — stonegalaxy-style reveal. The footer container pins; as you
 * scroll, the dark rounded panel translates UP and uncovers the oversized
 * BERLIN wordmark behind it on a warm light base, with a small © / location
 * line at the very bottom. Driven by [data-footer-panel] in animations.ts.
 * Falls back (no JS) to the panel simply sitting above the revealed wordmark.
 */
import { brand, nav, contact, social } from "../../data/site";
const year = new Date().getFullYear();
---

<section class="brandfoot mode-night" data-brandfoot>
  <div class="brandfoot__pin" data-brandfoot-pin>
    <!-- Revealed behind the panel -->
    <div class="brandfoot__reveal" aria-hidden="true">
      <span class="brandfoot__word">{brand.name}</span>
      <div class="brandfoot__mini">
        <p>© {year} {brand.name} {brand.tagline}</p>
        <p>Vijay Nagar, Indore</p>
      </div>
    </div>

    <!-- The dark panel that lifts away -->
    <footer class="footer" data-footer-panel>
      <div class="footer__feature container--xl">
        <div class="footer__feature-col">
          <span class="footer__eyebrow">More Berlin</span>
          <div class="footer__big">
            {social.map((s) => (
              <a class="footer__big-link" href={s.href} target="_blank" rel="noopener" data-cursor>
                {s.label}
              </a>
            ))}
          </div>
        </div>
        <div class="footer__feature-col">
          <span class="footer__eyebrow">Reservations &amp; enquiries</span>
          <a class="footer__big-link footer__big-link--sm" href={contact.phoneHref} data-cursor>
            {contact.phoneDisplay}
          </a>
          <div class="footer__feature-links">
            <a href={contact.whatsappHref} target="_blank" rel="noopener">Chat on WhatsApp</a>
            <a href={contact.mapsHref} target="_blank" rel="noopener">Get directions</a>
          </div>
        </div>
      </div>

      <div class="footer__rule container--xl"><span></span></div>

      <div class="footer__cols container--xl">
        <div class="footer__col footer__col--brand">
          <a class="footer__wordmark" href="#top" data-cursor>
            <span class="footer__name">{brand.name}</span>
            <span class="footer__tagline">{brand.tagline}</span>
          </a>
          <p class="footer__pitch">
            A rooftop gourmet house &amp; bar, six floors above the city — global
            flavours, crafted cocktails, and long Berlin nights.
          </p>
          <span class="footer__est">Est. Vijay Nagar · Level 06</span>
        </div>

        <nav class="footer__col" aria-label="Sections">
          <h2 class="footer__heading">Explore</h2>
          <ul>{nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
        </nav>

        <div class="footer__col">
          <h2 class="footer__heading">Visit</h2>
          <address class="footer__address">
            {contact.address.line1}<br />{contact.address.line2}<br />{contact.address.line3}
          </address>
          <p class="footer__hours">{contact.hours}</p>
        </div>

        <div class="footer__col">
          <h2 class="footer__heading">Contact</h2>
          <a class="footer__phone" href={contact.phoneHref}>{contact.phoneDisplay}</a>
          <ul>
            <li><a href={contact.whatsappHref} target="_blank" rel="noopener">WhatsApp</a></li>
            <li><a href={contact.mapsHref} target="_blank" rel="noopener">Directions</a></li>
          </ul>
        </div>
      </div>

      <div class="footer__base">
        <div class="footer__base-inner container--xl">
          <p>© {year} {brand.name} {brand.tagline}. All rights reserved.</p>
          <p class="footer__legal">
            <a href="#top">Privacy Policy</a>
            <a href="#top">Terms of Use</a>
          </p>
          <p>Rooftop Gourmet House · Indore</p>
        </div>
      </div>
    </footer>
  </div>
</section>

<style>
  .brandfoot { position: relative; }

  .brandfoot__pin {
    position: relative;
    background-color: #e6ddcb; /* warm light reveal base */
  }
  /* When enhanced, the container pins full-screen and the panel lifts. */
  .brandfoot.is-enhanced .brandfoot__pin {
    min-height: 100svh;
    overflow: hidden;
  }
  .brandfoot.is-enhanced .footer {
    min-height: 100svh;
  }

  /* --- Revealed wordmark. Default: sits under the panel. Enhanced: pinned to
     the bottom, uncovered as the panel lifts. --------------------------------*/
  .brandfoot__reveal {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2.5rem, 5vw, 4rem);
  }
  .brandfoot.is-enhanced .brandfoot__reveal {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 24vh;
    padding-block: 0;
  }
  .brandfoot__word {
    font-family: var(--font-display);
    font-weight: 400;
    /* Cap by viewport HEIGHT too, so the word always fits the reveal zone and
       the panel stops just above it (no huge gap on short/wide viewports). */
    font-size: clamp(2.5rem, min(15vw, 17vh), 13rem);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--color-berlin-red);
    user-select: none;
  }
  .brandfoot__mini {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: var(--gutter);
    padding-block-end: clamp(1rem, 2vw, 1.75rem);
    display: flex;
    justify-content: space-between;
    gap: var(--space-16);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: rgba(23, 21, 18, 0.35);
  }

  /* --- The dark panel ----------------------------------------------------- */
  .footer {
    position: relative;
    z-index: 10;
    background-color: var(--color-charcoal);
    color: var(--text);
    border-end-start-radius: clamp(2rem, 4vw, 3.75rem);
    border-end-end-radius: clamp(2rem, 4vw, 3.75rem);
    box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.45);
    will-change: transform;
    padding-block-end: clamp(1rem, 2vw, 1.5rem);
  }

  .footer__feature {
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: clamp(3.5rem, 8vw, 8rem) clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .footer__eyebrow {
    display: block;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-end: var(--space-24);
  }
  .footer__big { display: flex; flex-direction: column; gap: 0.25rem; }
  .footer__big-link {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--text-muted);
    transition: color 0.5s var(--ease-out);
  }
  .footer__big-link--sm { font-size: clamp(1.5rem, 3.2vw, 2.75rem); }
  .footer__big-link:hover { color: var(--text-strong); }
  .footer__feature-links {
    margin-block-start: var(--space-24);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .footer__feature-links a {
    font-size: var(--fs-caption);
    letter-spacing: 0.04em;
    color: var(--text-muted);
    transition: color 0.3s var(--ease-out);
  }
  .footer__feature-links a:hover { color: var(--accent); }

  .footer__rule { margin-inline: auto; padding-inline: var(--gutter); }
  .footer__rule span { display: block; height: 1px; background: var(--border-subtle); }

  .footer__cols {
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 4vw, 4rem);
  }
  .footer__wordmark { display: flex; flex-direction: column; line-height: 1; color: var(--text-strong); }
  .footer__name { font-family: var(--font-display); font-size: 1.75rem; letter-spacing: 0.14em; }
  .footer__tagline {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-start: 0.4rem;
  }
  .footer__pitch {
    margin-block: var(--space-24) var(--space-16);
    max-width: 26rem;
    font-size: var(--fs-caption);
    line-height: 1.7;
    color: var(--text-muted);
  }
  .footer__est {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.7;
  }
  .footer__heading {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    margin-block-end: var(--space-24);
  }
  .footer__col ul { display: flex; flex-direction: column; gap: var(--space-12); }
  .footer__col a {
    font-size: var(--fs-caption);
    letter-spacing: 0.04em;
    color: var(--text-muted);
    transition: color 0.3s var(--ease-out);
  }
  .footer__col a:hover { color: var(--accent); }
  .footer__address { font-style: normal; font-size: var(--fs-caption); line-height: 1.7; color: var(--text-muted); }
  .footer__hours { margin-block-start: var(--space-16); font-size: var(--fs-caption); color: var(--text-muted); }
  .footer__phone {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--text-strong);
    margin-block-end: var(--space-16);
  }
  .footer__phone:hover { color: var(--accent); }

  .footer__base { border-block-start: 1px solid var(--border-subtle); }
  .footer__base-inner {
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-24);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-16) var(--space-40);
  }
  .footer__base p,
  .footer__legal a {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .footer__legal { display: flex; gap: var(--space-32); }
  .footer__legal a { transition: color 0.3s var(--ease-out); }
  .footer__legal a:hover { color: var(--accent); }

  @media (min-width: 60rem) {
    .footer__feature { grid-template-columns: 1fr 1fr; }
    .footer__cols { grid-template-columns: 1.5fr 1fr 1.2fr 1fr; }
  }
</style>
