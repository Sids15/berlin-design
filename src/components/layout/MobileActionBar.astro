---
/**
 * MobileActionBar (§24) — persistent bottom bar on small screens:
 * Call · Reserve · Directions. Hidden on desktop.
 */
import { contact } from "../../data/site";
---

<nav class="mab" aria-label="Quick actions">
  <a class="mab__item" href={contact.phoneHref}>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 4h3l1.5 4-2 1.5a11 11 0 0 0 5 5l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
    </svg>
    <span>Call</span>
  </a>
  <a class="mab__item mab__item--primary" href="#visit">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="4" y="5" width="16" height="16" rx="1" stroke="currentColor" stroke-width="1.4" />
      <path d="M4 9h16M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
    <span>Reserve</span>
  </a>
  <a class="mab__item" href={contact.mapsHref} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 21s7-5.686 7-11a7 7 0 1 0-14 0c0 5.314 7 11 7 11Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
      <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.4" />
    </svg>
    <span>Directions</span>
  </a>
</nav>

<style>
  .mab {
    display: none;
    position: fixed;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: var(--z-header);
    grid-template-columns: repeat(3, 1fr);
    background: rgba(9, 9, 8, 0.92);
    border-block-start: 1px solid var(--border-subtle);
    padding-block-end: env(safe-area-inset-bottom, 0);
    backdrop-filter: blur(8px);
  }

  .mab__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 3.75rem;
    color: var(--text-muted);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }
  .mab__item svg { width: 1.25rem; height: 1.25rem; }
  .mab__item--primary { color: var(--accent); }
  .mab__item + .mab__item { border-inline-start: 1px solid var(--border-subtle); }

  @media (max-width: 48rem) {
    .mab { display: grid; }
  }
</style>
