---
/**
 * The Table (06) — Mode B (Editorial, light). A deliberate visual reset: paper
 * ground, a typographic menu spread, one signature dish. Light editorial, not
 * a grid of cards (§20, §23).
 * PLACEHOLDER IMAGE: free-license (Unsplash), @swap.
 */
import { Picture } from "astro:assets";
import SectionLabel from "../ui/SectionLabel.astro";
import Button from "../ui/Button.astro";
// @swap: final signature-dish photograph.
import signature from "../../assets/menu/menu-signature.jpg";

const menu = [
  {
    heading: "To Begin",
    items: [
      { name: "Burrata & Heirloom Tomatoes", note: "Basil oil, aged balsamic", price: "780" },
      { name: "Wagyu Beef Dim Sum", note: "Black garlic, chilli crisp", price: "1100" },
    ],
  },
  {
    heading: "From the Kitchen",
    items: [
      { name: "Truffle Wild Mushroom Risotto", note: "Parmesan, thyme", price: "920" },
      { name: "Paneer Butter Masala", note: "Smoked tomato, kasuri methi", price: "640" },
      { name: "Charcoal Rooftop Grill", note: "Market catch, seasonal", price: "1240" },
    ],
  },
];
---

<section id="menu" class="menu mode-editorial section" data-journey-section>
  <div class="menu__head container--xl">
    <SectionLabel index="06" data-reveal>The Table</SectionLabel>
    <h2 class="menu__title" data-split>
      A table full of<br /><em>possibilities.</em>
    </h2>
    <p class="menu__intro" data-reveal>
      From Pan-Asian and Continental to North Indian and Mediterranean — a short
      look at the table. The full menu changes with the season.
    </p>
  </div>

  <div class="menu__grid container--xl">
    <div class="menu__list">
      {menu.map((group) => (
        <div class="menu__group" data-reveal>
          <h3 class="menu__group-heading">{group.heading}</h3>
          <ul>
            {group.items.map((item) => (
              <li class="menu__item">
                <div class="menu__item-main">
                  <span class="menu__item-name">{item.name}</span>
                  <span class="menu__item-note">{item.note}</span>
                </div>
                <span class="menu__leader" aria-hidden="true"></span>
                <span class="menu__price">₹{item.price}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="menu__cta" data-reveal>
        <Button href="#visit" variant="primary" arrow={false} data-magnetic="0.25">Reserve a table</Button>
      </div>
    </div>

    <figure class="menu__figure" data-reveal>
      <Picture
        src={signature}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        alt="A signature course, plated"
        widths={[600, 900, 1200]}
        sizes="(max-width: 60rem) 100vw, 42vw"
        loading="lazy"
        class="menu__image"
        data-clip
      />
      <figcaption class="menu__figcaption">Chef's signature · changes nightly</figcaption>
    </figure>
  </div>
</section>

<style>
  .menu {
    background-color: var(--bg);
    color: var(--text);
  }

  .menu__head {
    margin-inline: auto;
    padding-inline: var(--gutter);
    max-width: var(--container-lg);
    text-align: center;
  }
  .menu__head :global(.section-label) {
    justify-content: center;
  }
  .menu__title {
    margin-block-start: var(--space-24);
    font-family: var(--font-display);
    font-size: var(--fs-display-m);
    line-height: 1.03;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }
  .menu__title em { font-style: italic; color: var(--accent); }
  .menu__intro {
    margin: var(--space-24) auto 0;
    max-width: 34rem;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  .menu__grid {
    margin-inline: auto;
    padding-inline: var(--gutter);
    margin-block-start: clamp(3rem, 7vw, 6rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .menu__group + .menu__group { margin-block-start: var(--space-48); }
  .menu__group-heading {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    padding-block-end: var(--space-16);
    border-block-end: 1px solid var(--border-subtle);
  }

  .menu__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-16);
    padding-block: var(--space-24);
    border-block-end: 1px solid var(--border-subtle);
  }
  .menu__item-main { display: flex; flex-direction: column; gap: 0.3rem; }
  .menu__item-name {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--text-strong);
  }
  .menu__item-note {
    font-size: var(--fs-caption);
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  .menu__leader {
    flex: 1;
    align-self: center;
    border-block-end: 1px dotted var(--border-strong);
    min-width: 1.5rem;
  }
  .menu__price {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .menu__cta { margin-block-start: var(--space-40); }

  .menu__figure { margin: 0; position: relative; }
  .menu__image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
  }
  .menu__figcaption {
    margin-block-start: var(--space-16);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (min-width: 60rem) {
    .menu__grid { grid-template-columns: 1.15fr 0.85fr; }
    .menu__figure { position: sticky; top: 6rem; }
  }
</style>
