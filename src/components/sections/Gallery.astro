---
/**
 * Moments — a horizontal-scroll gallery that hijacks vertical scroll (the
 * section pins and the track slides sideways). Breaks the vertical rhythm and
 * gathers the night into one editorial strip. Reuses existing imagery.
 * Static content (no reveal/split) — the horizontal motion is the animation,
 * and reveals inside a pinned+translated track are unreliable.
 */
import { Image } from "astro:assets";
import SectionLabel from "../ui/SectionLabel.astro";
import interior from "../../assets/experience/experience-interior.jpg";
import rooftop from "../../assets/rooftop/rooftop-city-night.jpg";
import plate from "../../assets/dining/dining-plate.jpg";
import crowd from "../../assets/after-dark/after-dark-crowd.jpg";
import signature from "../../assets/menu/menu-signature.jpg";

const panels = [
  { img: rooftop, caption: "The Rooftop", note: "Six floors up" },
  { img: interior, caption: "The Room", note: "Low light, linen" },
  { img: plate, caption: "The Table", note: "Plated with intent" },
  { img: crowd, caption: "After Dark", note: "The night sets in" },
  { img: signature, caption: "The Signature", note: "Changes nightly" },
];
---

<section class="moments mode-night" data-horizontal aria-label="Moments at Berlin">
  <div class="moments__track" data-horizontal-track>
    <div class="moments__intro">
      <SectionLabel index="—">Moments</SectionLabel>
      <p class="moments__title">A night<br /><em>at Berlin.</em></p>
      <p class="moments__hint" aria-hidden="true">Scroll →</p>
    </div>

    <figure class="moments__panel moments__panel--tall">
      <img
        class="moments__img"
        src="/videos/hero/frames/frame-0129.webp"
        width="1200"
        height="1600"
        loading="lazy"
        decoding="async"
        alt="The signature Berlin glass, etched crystal on black"
      />
      <figcaption class="moments__cap"><span>The Pour</span><span class="moments__note">Signature ritual</span></figcaption>
    </figure>

    {panels.map((p) => (
      <figure class="moments__panel">
        <Image
          class="moments__img"
          src={p.img}
          alt={p.caption}
          widths={[500, 800]}
          sizes="32rem"
          loading="lazy"
        />
        <figcaption class="moments__cap">
          <span>{p.caption}</span>
          <span class="moments__note">{p.note}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .moments {
    background-color: var(--color-void);
    overflow: hidden;
  }

  /* Fallback (no JS / reduced motion): a normal horizontal-scroll strip. */
  .moments__track {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    height: 100svh;
    padding-inline: var(--gutter);
    width: max-content;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .moments__track::-webkit-scrollbar { display: none; }

  .moments__intro {
    flex: 0 0 auto;
    width: min(28rem, 74vw);
    padding-inline-end: clamp(1rem, 3vw, 3rem);
  }
  .moments__title {
    margin-block-start: var(--space-24);
    font-family: var(--font-display);
    font-size: var(--fs-display-m);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }
  .moments__title em { font-style: italic; color: var(--accent); }
  .moments__hint {
    margin-block-start: var(--space-32);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .moments__panel {
    flex: 0 0 auto;
    width: clamp(18rem, 40vw, 30rem);
    margin: 0;
  }
  .moments__panel--tall { width: clamp(16rem, 32vw, 24rem); }

  .moments__img {
    width: 100%;
    height: 68svh;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
    background: var(--color-charcoal);
  }
  .moments__panel--tall .moments__img { background: var(--color-void); }

  .moments__cap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-16);
    margin-block-start: var(--space-16);
  }
  .moments__cap > span:first-child {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--text-strong);
  }
  .moments__note {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* When JS drives the horizontal pin, disable native overflow scrolling. */
  :global(.has-horizontal) .moments__track {
    overflow: visible;
  }
</style>
