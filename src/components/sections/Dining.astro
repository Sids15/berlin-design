---
/**
 * Dining (03) — asymmetric editorial split, image leading. A menu that travels.
 * PLACEHOLDER IMAGE: free-license (Unsplash), @swap.
 */
import { Picture } from "astro:assets";
import SectionLabel from "../ui/SectionLabel.astro";
import Button from "../ui/Button.astro";
// @swap: final plated-dish / dining photograph.
import plate from "../../assets/dining/dining-plate.jpg";
---

<section id="dining" class="dining section mode-night" data-journey-section>
  <div class="dining__grid container--xl">
    <figure class="dining__figure" data-reveal>
      <Picture
        src={plate}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        alt="A plated course at Berlin — Haus de Gourmet"
        widths={[600, 900, 1200]}
        sizes="(max-width: 60rem) 100vw, 48vw"
        loading="lazy"
        class="dining__image"
        data-clip
      />
    </figure>

    <div class="dining__text">
      <SectionLabel index="03" data-reveal>Dining</SectionLabel>
      <h2 class="dining__headline" data-split>
        A menu that travels<br /><em>across continents.</em>
      </h2>
      <p class="dining__copy" data-reveal>
        Pan-Asian, Continental, North Indian, Mediterranean — a table full of
        possibilities, each plate crafted with intent and served the moment
        it's ready.
      </p>
      <ul class="dining__list" data-reveal>
        <li>Small plates &amp; sharing boards</li>
        <li>Wood-fire mains</li>
        <li>Late-night bites</li>
      </ul>
      <div class="dining__cta" data-reveal>
        <Button href="#menu" variant="secondary">See the table</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .dining {
    background-color: var(--color-charcoal);
    overflow: clip;
  }

  .dining__grid {
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .dining__figure {
    margin: 0;
  }

  .dining__image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
  }

  .dining__text {
    max-width: 32rem;
  }

  .dining__headline {
    margin-block-start: var(--space-24);
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }
  .dining__headline em { font-style: italic; color: var(--accent); }

  .dining__copy {
    margin-block-start: var(--space-24);
    font-size: var(--fs-body-l);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  .dining__list {
    margin-block-start: var(--space-32);
    display: flex;
    flex-direction: column;
  }
  .dining__list li {
    padding-block: var(--space-16);
    border-block-start: 1px solid var(--border-subtle);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text);
  }
  .dining__list li:last-child {
    border-block-end: 1px solid var(--border-subtle);
  }

  .dining__cta { margin-block-start: var(--space-40); }

  @media (min-width: 60rem) {
    .dining__grid {
      grid-template-columns: 1fr 0.9fr;
    }
    .dining__text { justify-self: end; }
  }
</style>
