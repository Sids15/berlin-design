---
/**
 * Reviews (07) — typography-led, no imagery (§20). A count-up rating and a few
 * guest quotes, set as an editorial spread rather than cards.
 */
import SectionLabel from "../ui/SectionLabel.astro";

const quotes = [
  { text: "Amazing rooftop ambience, delicious food and super friendly staff.", source: "Google Review" },
  { text: "The sunset view is unmatched. The perfect place for a special evening.", source: "Zomato" },
  { text: "Every dish we tried was flavourful and beautifully presented.", source: "Swiggy Dineout" },
];
---

<section id="reviews" class="rev section mode-night" data-journey-section>
  <div class="rev__head container--xl">
    <SectionLabel index="07" data-reveal>What our guests say</SectionLabel>
  </div>

  <div class="rev__grid container--xl">
    <div class="rev__score" data-reveal>
      <p class="rev__rating">
        <span class="rev__rating-num" data-count="4.7" data-decimals="1">4.7</span>
        <span class="rev__rating-out">/ 5</span>
      </p>
      <p class="rev__stars" aria-hidden="true">★★★★★</p>
      <p class="rev__score-label">Rated across 1000+ reviews</p>
    </div>

    <ul class="rev__quotes">
      {quotes.map((q) => (
        <li class="rev__quote" data-reveal>
          <p class="rev__quote-text">“{q.text}”</p>
          <p class="rev__quote-source">— {q.source}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rev { background-color: var(--color-void); }

  .rev__head {
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .rev__grid {
    margin-inline: auto;
    padding-inline: var(--gutter);
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .rev__rating {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .rev__rating-num {
    font-family: var(--font-display);
    font-size: var(--fs-display-l);
    line-height: 0.9;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }
  .rev__rating-out {
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    color: var(--text-muted);
  }
  .rev__stars {
    margin-block-start: var(--space-16);
    color: var(--accent);
    letter-spacing: 0.3em;
    font-size: var(--fs-heading-s);
  }
  .rev__score-label {
    margin-block-start: var(--space-16);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .rev__quotes {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .rev__quote {
    padding-block: var(--space-40);
    border-block-start: 1px solid var(--border-subtle);
  }
  .rev__quote:last-child { border-block-end: 1px solid var(--border-subtle); }
  .rev__quote-text {
    font-family: var(--font-display);
    font-size: var(--fs-heading-m);
    line-height: 1.3;
    color: var(--text);
    max-width: 40rem;
  }
  .rev__quote-source {
    margin-block-start: var(--space-16);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }

  @media (min-width: 60rem) {
    .rev__grid { grid-template-columns: 0.7fr 1.3fr; }
  }
</style>
