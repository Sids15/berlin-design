---
/**
 * After Dark (05) — Mode C. The one place Berlin-red enters, as reflected club
 * light. Full-bleed nightlife image, an event feature, and a quiet marquee of
 * upcoming nights.
 * PLACEHOLDER IMAGE: free-license (Unsplash), @swap.
 */
import { Picture } from "astro:assets";
import SectionLabel from "../ui/SectionLabel.astro";
import Button from "../ui/Button.astro";
// @swap: final event / nightlife photograph.
import crowd from "../../assets/after-dark/after-dark-crowd.jpg";

const nights = [
  "Glass House Sessions",
  "Rooftop Vinyl",
  "Late Set · Live Jazz",
  "House on Six",
  "Midnight Supper Club",
];
---

<section id="after-dark" class="dark mode-after-dark" data-journey-section>
  <div class="dark__media" aria-hidden="true">
    <Picture
      src={crowd}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      alt=""
      widths={[900, 1400, 2000, 2400]}
      sizes="100vw"
      loading="lazy"
      class="dark__image"
    />
    <div class="dark__scrim"></div>
  </div>

  <div class="dark__inner container--xl">
    <div class="dark__body">
      <SectionLabel index="05" data-reveal>After Dark</SectionLabel>
      <h2 class="dark__headline" data-reveal>
        Music. Nights.<br /><em>Memories.</em>
      </h2>
      <p class="dark__copy" data-reveal>
        From curated gigs to live performances, the night comes alive at Berlin —
        crafted sets under the open sky.
      </p>
    </div>

    <aside class="dark__event" data-reveal>
      <div class="dark__event-date">
        <span class="dark__event-day">16</span>
        <span class="dark__event-month">May</span>
      </div>
      <p class="dark__event-title">Glass House Sessions</p>
      <p class="dark__event-meta">Live Music · Rooftop, Berlin</p>
      <Button href="#visit" variant="primary" arrow={false}>Book your spot</Button>
    </aside>
  </div>

  <div class="dark__marquee" aria-hidden="true">
    <div class="dark__track">
      {[...nights, ...nights].map((n) => (
        <span class="dark__night">{n}<span class="dark__dot">✦</span></span>
      ))}
    </div>
  </div>
</section>

<style>
  .dark {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-void);
    padding-block: var(--space-section);
  }

  .dark__media { position: absolute; inset: 0; z-index: -2; }
  .dark__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.62) contrast(1.08) saturate(1.05);
  }
  .dark__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 80% at 30% 40%, rgba(100, 28, 24, 0.4) 0%, rgba(9, 9, 8, 0) 60%),
      linear-gradient(to top, var(--color-void) 6%, rgba(9, 9, 8, 0.35) 55%, rgba(9, 9, 8, 0.7) 100%);
  }

  .dark__inner {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .dark__body { max-width: 36rem; }
  .dark__headline {
    margin-block-start: var(--space-24);
    font-family: var(--font-display);
    font-size: var(--fs-display-m);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }
  .dark__headline em { font-style: italic; color: var(--accent); }
  .dark__copy {
    margin-block-start: var(--space-24);
    max-width: 30rem;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  /* Event feature — a rare, deliberate bordered block (§23) */
  .dark__event {
    border: 1px solid var(--accent-muted);
    background: rgba(9, 9, 8, 0.55);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 22rem;
  }
  .dark__event-date { display: flex; align-items: baseline; gap: 0.5rem; }
  .dark__event-day {
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    line-height: 1;
    color: var(--text-strong);
  }
  .dark__event-month {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .dark__event-title {
    margin-block-start: var(--space-16);
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--text-strong);
  }
  .dark__event-meta {
    margin-block: 0.35rem var(--space-24);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Marquee of upcoming nights — quiet, low-contrast (§18, kept restrained) */
  .dark__marquee {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    overflow: hidden;
    border-block-start: 1px solid var(--border-subtle);
    padding-block: var(--space-16);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .dark__track {
    display: flex;
    width: max-content;
    gap: var(--space-40);
    animation: marquee 38s linear infinite;
  }
  .dark__night {
    display: inline-flex;
    align-items: center;
    gap: var(--space-40);
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .dark__dot { color: var(--accent); font-size: 0.7em; }

  @media (min-width: 60rem) {
    .dark__inner { grid-template-columns: 1fr auto; }
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>
