---
/**
 * Reservation (08 · Visit) — cinematic conversion block. Rooftop ambience under
 * a heavy scrim; a booking control and the direct ways to reach the venue.
 * No backend yet — "Check availability" hands off to WhatsApp; the selects are
 * live UI to be wired to a booking provider later.
 * PLACEHOLDER IMAGE: reuses the rooftop shot, @swap.
 */
import { Picture } from "astro:assets";
import Button from "../ui/Button.astro";
import { contact } from "../../data/site";
import rooftop from "../../assets/rooftop/rooftop-city-night.jpg";

const times = ["7:00 PM", "7:30 PM", "8:00 PM", "8:30 PM", "9:00 PM", "9:30 PM"];
const guests = ["2 guests", "3 guests", "4 guests", "5 guests", "6+ guests"];
---

<section id="visit" class="visit mode-night" data-journey-section>
  <div class="visit__media" aria-hidden="true">
    <Picture
      src={rooftop}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      alt=""
      widths={[900, 1400, 2000, 2400]}
      sizes="100vw"
      loading="lazy"
      class="visit__image"
      data-parallax="0.12"
    />
    <div class="visit__scrim"></div>
  </div>

  <div class="visit__inner container--xl">
    <div class="visit__head">
      <h2 class="visit__headline" data-split>
        Your table<br /><em>awaits.</em>
      </h2>
      <p class="visit__copy" data-reveal>
        Make a reservation and let the night begin.
      </p>
    </div>

    <form class="visit__form" data-reveal action={contact.whatsappHref} method="get" target="_blank">
      <div class="visit__field">
        <label for="res-date">Date</label>
        <input id="res-date" name="date" type="date" />
      </div>
      <div class="visit__field">
        <label for="res-time">Time</label>
        <select id="res-time" name="time">
          {times.map((t) => <option>{t}</option>)}
        </select>
      </div>
      <div class="visit__field">
        <label for="res-guests">Guests</label>
        <select id="res-guests" name="guests">
          {guests.map((g) => <option>{g}</option>)}
        </select>
      </div>
      <button class="visit__submit" type="submit" data-magnetic="0.3">Check availability</button>
    </form>

    <div class="visit__contact" data-reveal>
      <a class="visit__contact-item" href={contact.phoneHref}>
        <span class="visit__contact-label">Call us</span>
        <span class="visit__contact-value">{contact.phoneDisplay}</span>
      </a>
      <a class="visit__contact-item" href={contact.whatsappHref} target="_blank" rel="noopener">
        <span class="visit__contact-label">WhatsApp</span>
        <span class="visit__contact-value">Chat with us</span>
      </a>
      <a class="visit__contact-item" href={contact.mapsHref} target="_blank" rel="noopener">
        <span class="visit__contact-label">Directions</span>
        <span class="visit__contact-value">Find us on the map</span>
      </a>
    </div>
  </div>
</section>

<style>
  .visit {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-void);
    padding-block: var(--space-section);
  }

  .visit__media { position: absolute; inset: 0; z-index: -2; }
  .visit__image {
    width: 100%;
    height: 124%;
    margin-block-start: -12%;
    object-fit: cover;
    filter: brightness(0.5) contrast(1.05) saturate(0.9);
  }
  .visit__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, var(--color-void) 6%, rgba(9, 9, 8, 0.55) 60%, rgba(9, 9, 8, 0.75) 100%);
  }

  .visit__inner {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .visit__headline {
    font-family: var(--font-display);
    font-size: var(--fs-display-l);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }
  .visit__headline em { font-style: italic; color: var(--accent); }
  .visit__copy {
    margin-block-start: var(--space-24);
    font-size: var(--fs-body-l);
    color: var(--text-muted);
  }

  /* Booking control — bordered, rectangular, no floating cards (§11, §12) */
  .visit__form {
    margin-block-start: var(--space-48);
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    max-width: 52rem;
  }
  .visit__field {
    flex: 1 1 10rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: var(--space-16) var(--space-24);
    background: rgba(9, 9, 8, 0.7);
  }
  .visit__field label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .visit__field input,
  .visit__field select {
    background: transparent;
    border: none;
    color: var(--text-strong);
    font-family: var(--font-ui);
    font-size: var(--fs-body);
    padding: 0.15rem 0;
    color-scheme: dark;
  }
  .visit__field select { appearance: none; cursor: pointer; }
  .visit__field input:focus-visible,
  .visit__field select:focus-visible { outline: none; color: var(--accent); }

  .visit__submit {
    flex: 1 1 12rem;
    padding: var(--space-16) var(--space-32);
    background: color-mix(in srgb, var(--accent) 88%, transparent);
    color: var(--color-void);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    transition: background-color 0.4s var(--ease-out), color 0.4s var(--ease-out);
  }
  .visit__submit:hover,
  .visit__submit:focus-visible {
    background: var(--color-void);
    color: var(--accent);
  }

  .visit__contact {
    margin-block-start: var(--space-48);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .visit__contact-item { display: flex; flex-direction: column; gap: 0.35rem; }
  .visit__contact-label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .visit__contact-value {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--text-strong);
    transition: color 0.35s var(--ease-out);
  }
  .visit__contact-item:hover .visit__contact-value { color: var(--accent); }

  @media (max-width: 48rem) {
    .visit__headline { font-size: var(--fs-display-m); }
    .visit__submit { flex-basis: 100%; }
  }
</style>
