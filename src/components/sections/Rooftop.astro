---
/**
 * The Rooftop (02) — full-bleed golden-hour immersive. Content anchored
 * bottom-left, a full-width feature bar at the base. Distinct from the
 * editorial split above, kept deliberately simple and robust.
 * PLACEHOLDER IMAGE: free-license (Unsplash), @swap.
 */
import { Picture } from "astro:assets";
import Button from "../ui/Button.astro";
// @swap: final rooftop photograph (rooftop + city + tables + depth, wide).
import rooftop from "../../assets/rooftop/rooftop-city-night.jpg";

const features = [
  { value: "Open Sky", label: "Al fresco dining" },
  { value: "Golden Hour", label: "Sunsets, nightly" },
  { value: "City Skyline", label: "Vijay Nagar below" },
  { value: "The Terrace", label: "Level 06" },
];
---

<section id="rooftop" class="roof mode-night" data-journey-section>
  <div class="roof__media" aria-hidden="true">
    <Picture
      src={rooftop}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      alt=""
      widths={[900, 1400, 2000, 2400]}
      sizes="100vw"
      loading="lazy"
      class="roof__image"
      data-parallax="0.12"
    />
    <div class="roof__scrim"></div>
  </div>

  <div class="roof__content container--xl">
    <p class="roof__eyebrow" data-reveal>02 · Above the city</p>
    <h2 class="roof__headline" data-reveal>
      Where sunsets turn<br />into <em>stories.</em>
    </h2>
    <p class="roof__copy" data-reveal>
      Open sky, low light, and the skyline for company. Six floors up, the
      evening slows down — and the night begins.
    </p>
    <div data-reveal>
      <Button href="#menu" variant="secondary">View the menu</Button>
    </div>
  </div>

  <ul class="roof__features container--xl" data-reveal>
    {features.map((f) => (
      <li class="roof__feature">
        <span class="roof__feature-value">{f.value}</span>
        <span class="roof__feature-label">{f.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .roof {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-void);
  }

  .roof__media { position: absolute; inset: 0; z-index: -2; }
  .roof__image {
    width: 100%;
    height: 124%;
    margin-block-start: -12%;
    object-fit: cover;
    filter: brightness(0.82) contrast(1.05) saturate(1.02);
  }
  .roof__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--color-void) 4%, rgba(9, 9, 8, 0.12) 45%, rgba(9, 9, 8, 0.5) 100%),
      linear-gradient(to top, rgba(150, 96, 44, 0.22) 0%, rgba(150, 96, 44, 0) 34%),
      linear-gradient(to right, rgba(9, 9, 8, 0.6) 0%, rgba(9, 9, 8, 0) 58%);
  }

  .roof__content {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block-end: clamp(2.5rem, 6vh, 4.5rem);
    max-width: var(--container-xl);
  }

  .roof__eyebrow {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }

  .roof__headline {
    margin-block-start: var(--space-24);
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: var(--fs-display-l);
    line-height: 1.0;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }
  .roof__headline em { font-style: italic; color: var(--accent); }

  .roof__copy {
    margin-block: var(--space-32);
    max-width: 32rem;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  /* Feature bar across the base */
  .roof__features {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
    max-width: var(--container-xl);
    display: flex;
    flex-wrap: wrap;
    border-block-start: 1px solid var(--border-subtle);
  }
  .roof__feature {
    flex: 1 1 10rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-block: clamp(1.25rem, 3vh, 1.75rem);
    padding-inline: 0 var(--space-32);
  }
  .roof__feature + .roof__feature {
    border-inline-start: 1px solid var(--border-subtle);
    padding-inline-start: var(--space-32);
  }
  .roof__feature-value {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--text-strong);
  }
  .roof__feature-label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 48rem) {
    .roof__headline { font-size: var(--fs-display-m); }
    .roof__features {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .roof__features::-webkit-scrollbar { display: none; }
    .roof__feature { flex: 0 0 auto; min-width: 9rem; }
  }
</style>
