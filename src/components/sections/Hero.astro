---
/**
 * Hero + The Experience — the opening cinematic (Sections 18, 20, 21, 30).
 *
 * One pinned scroll stage tells the opening in three acts:
 *   I.  The Pour   — scroll scrubs a WebP frame sequence; the glass fills.
 *   Freeze         — at frame 130 the branded glass sits centred on black.
 *   II. The Table  — the frozen glass stays pinned while text beats reveal
 *                    around it (The Experience + a count-up proof beat).
 *   III. Release   — an overlay eases to full black, handing off to the site.
 *
 * Progressive enhancement: the base layout is a readable, static stack. When
 * JS runs and motion is allowed, `.cinema--on` switches to the pinned cinematic
 * driven by GSAP ScrollTrigger, with Lenis smoothing the whole page.
 *
 * PLACEHOLDER MEDIA: frames from a placeholder pour clip (`npm run frames`),
 * marked for swap with the final footage.
 */
import { brand, contact } from "../../data/site";
import Button from "../ui/Button.astro";
import SectionLabel from "../ui/SectionLabel.astro";

const FRAME_COUNT = 130; // keep in sync with scripts/extract-frames.mjs
const FRAME_DIR = "/videos/hero/frames";
---

<section
  id="top"
  class="cinema mode-night"
  aria-label="Berlin — Haus de Gourmet"
  data-cinema
  data-frame-count={FRAME_COUNT}
  data-frame-dir={FRAME_DIR}
>
  <div class="cinema__pin" data-cinema-pin>
    <canvas class="cinema__canvas" data-cinema-canvas aria-hidden="true"></canvas>
    <div class="cinema__scrim" aria-hidden="true"></div>

    <!-- Act I — hero copy (left) -->
    <div class="cinema__stage container--xl">
      <div class="cinema__beat cinema__beat--hero" data-beat="hero">
        <p class="cinema__eyebrow">{contact.address.line2}</p>
        <h1 class="cinema__headline">
          <span class="cinema__line">Dining.</span>
          <span class="cinema__line">Drinking.</span>
          <span class="cinema__line cinema__line--accent">Nights.</span>
        </h1>
        <p class="cinema__sub">A rooftop gourmet house<br />above the city.</p>
        <div class="cinema__actions">
          <Button href="#visit" variant="primary" arrow={false}>Reserve a Table</Button>
          <Button href="#menu" variant="secondary">Explore</Button>
        </div>
        <dl class="cinema__meta">
          <div class="cinema__meta-item">
            <svg class="cinema__meta-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.25" />
              <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div>
              <dt class="visually-hidden">Hours</dt>
              <dd class="cinema__meta-value">12:00 PM – 11:30 PM</dd>
              <dd class="cinema__meta-label">Everyday</dd>
            </div>
          </div>
          <span class="cinema__meta-divider" aria-hidden="true"></span>
          <div class="cinema__meta-item">
            <svg class="cinema__meta-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 21s7-5.686 7-11a7 7 0 1 0-14 0c0 5.314 7 11 7 11Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" />
              <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.25" />
            </svg>
            <div>
              <dt class="visually-hidden">Address</dt>
              <dd class="cinema__meta-value">{contact.address.line1}</dd>
              <dd class="cinema__meta-label">{contact.address.line2}</dd>
            </div>
          </div>
        </dl>
      </div>
    </div>

    <!-- Act II · beat 1 — The Experience (left) -->
    <div id="experience" class="cinema__stage container--xl" data-journey-section>
      <div class="cinema__beat cinema__beat--left" data-beat="1">
        <SectionLabel index="01">The Experience</SectionLabel>
        <p class="cinema__statement">
          Long evenings,<br />good company,<br /><em>great flavours.</em>
        </p>
        <p class="cinema__copy">
          A rooftop gourmet house where global flavours meet crafted cocktails,
          and the city lights set the mood. Six floors up, the evening is
          yours — unhurried, and unforgettable.
        </p>
      </div>
    </div>

    <!-- Act II · beat 2 — proof (right) -->
    <div class="cinema__stage container--xl">
      <div class="cinema__beat cinema__beat--right" data-beat="2">
        <ul class="cinema__stats">
          <li class="cinema__stat">
            <span class="cinema__stat-value" data-count="4.7" data-decimals="1">0.0</span>
            <span class="cinema__stat-label">Guest rating · 1000+ reviews</span>
          </li>
          <li class="cinema__stat">
            <span class="cinema__stat-value" data-count="1000" data-suffix="+">0</span>
            <span class="cinema__stat-label">Nights hosted above the city</span>
          </li>
          <li class="cinema__stat">
            <span class="cinema__stat-value" data-count="6" data-pad="2">00</span>
            <span class="cinema__stat-label">Floors up · Level 06, Vijay Nagar</span>
          </li>
        </ul>
        <a class="cinema__more" href="#menu">
          <span>Explore the menu</span>
          <svg width="36" height="8" viewBox="0 0 36 8" fill="none" aria-hidden="true">
            <path d="M0 4h34M34 4l-5-3.25M34 4l-5 3.25" stroke="currentColor" stroke-width="1" />
          </svg>
        </a>
      </div>
    </div>

    <a class="cinema__cue" href="#experience" data-beat="cue">
      <span class="cinema__cue-label">Scroll to begin</span>
      <span class="cinema__cue-line" aria-hidden="true"></span>
    </a>

    <div class="cinema__endfade" data-cinema-endfade aria-hidden="true"></div>
  </div>

  <span class="visually-hidden">{brand.description}</span>
</section>

<script>
  import { initCinema } from "../../scripts/cinema";
  initCinema();
</script>

<style>
  /* =========================================================================
     BASE (static, progressive-enhancement fallback) — readable stacked layout
     ========================================================================= */
  .cinema {
    position: relative;
    background-color: var(--color-void);
  }

  .cinema__pin {
    position: relative;
    overflow: hidden;
  }

  .cinema__canvas {
    display: block;
    width: 100%;
    height: 100svh;
    object-fit: cover;
    filter: brightness(0.92) contrast(1.05) saturate(0.96);
  }

  .cinema__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(to right, var(--color-void) 0%, rgba(9, 9, 8, 0.5) 26%, rgba(9, 9, 8, 0) 66%),
      linear-gradient(to top, var(--color-void) 0%, rgba(9, 9, 8, 0) 22%);
  }

  .cinema__stage {
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-section);
    position: relative;
    z-index: 2;
  }

  .cinema__beat {
    max-width: 40rem;
    will-change: opacity, transform;
  }

  .cinema__beat--right {
    margin-inline-start: auto;
    text-align: right;
  }

  /* --- Type ---------------------------------------------------------------- */
  .cinema__eyebrow {
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cinema__eyebrow::after {
    content: "";
    display: block;
    width: 2.75rem;
    height: 1px;
    margin-block-start: var(--space-16);
    background: var(--accent-muted);
  }

  .cinema__headline {
    margin-block-start: clamp(1.75rem, 4vh, 2.75rem);
    font-size: var(--fs-display-xl);
    line-height: var(--lh-display);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .cinema__line { display: block; }
  .cinema__line--accent { color: var(--accent); }

  .cinema__sub {
    margin-block-start: clamp(1.5rem, 3.5vh, 2.25rem);
    max-width: 22rem;
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .cinema__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    margin-block-start: clamp(2rem, 4.5vh, 3rem);
  }

  /* --- Meta ---------------------------------------------------------------- */
  .cinema__meta {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-block-start: clamp(3rem, 8vh, 5rem);
  }
  .cinema__meta-item { display: flex; align-items: center; gap: var(--space-16); }
  .cinema__meta-icon { width: 1.5rem; height: 1.5rem; flex-shrink: 0; color: var(--accent); }
  .cinema__meta-value {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }
  .cinema__meta-label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-start: 0.2rem;
  }
  .cinema__meta-divider {
    width: 1px;
    align-self: stretch;
    min-height: 2.5rem;
    background: var(--border-subtle);
  }

  /* --- Experience statement ------------------------------------------------ */
  .cinema__statement {
    margin-block-start: var(--space-32);
    font-family: var(--font-display);
    font-size: var(--fs-display-m);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
    max-width: none;
  }
  .cinema__statement em { font-style: italic; color: var(--accent); }

  .cinema__copy {
    margin-block-start: var(--space-32);
    max-width: 32rem;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  /* --- Stats --------------------------------------------------------------- */
  .cinema__stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-40);
  }
  .cinema__stat { display: flex; flex-direction: column; gap: 0.5rem; }
  .cinema__stat-value {
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    line-height: 1;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }
  .cinema__stat-label {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .cinema__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-16);
    margin-block-start: var(--space-40);
    justify-content: flex-end;
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--text);
    transition: color 0.4s var(--ease-out);
  }
  .cinema__more svg { transition: transform 0.4s var(--ease-out); }
  .cinema__more:hover { color: var(--accent); }
  .cinema__more:hover svg { transform: translateX(4px); }

  /* --- Scroll cue ---------------------------------------------------------- */
  .cinema__cue {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-16);
    color: var(--text-muted);
  }
  .cinema__cue-label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .cinema__cue-line {
    width: 1px;
    height: clamp(2.5rem, 7vh, 4.5rem);
    background: linear-gradient(to bottom, var(--accent-muted), transparent);
  }

  .cinema__endfade {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--color-void);
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 48rem) {
    .cinema__headline { font-size: var(--fs-display-l); }
    .cinema__statement { font-size: var(--fs-display-s); }
    .cinema__beat--right { text-align: left; margin-inline-start: 0; }
    .cinema__more { justify-content: flex-start; }
  }

  /* =========================================================================
     CINEMATIC (enhanced) — GSAP pins the stage; beats overlap and are driven
     by scroll. Only applied once JS confirms motion is allowed.
     ========================================================================= */
  .cinema--on .cinema__pin {
    height: 100svh;
  }
  .cinema--on .cinema__canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    height: 100%;
  }
  .cinema--on .cinema__stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-block: 0;
  }
  .cinema--on .cinema__beat {
    position: relative;
  }
  /* Beats that the timeline fades in start hidden in cinematic mode. */
  .cinema--on [data-beat="1"],
  .cinema--on [data-beat="2"] {
    opacity: 0;
  }
  .cinema--on .cinema__cue {
    display: flex;
    position: absolute;
    z-index: 2;
    inset-block-end: clamp(1.5rem, 4vh, 2.5rem);
    inset-inline-start: 50%;
    transform: translateX(-50%);
  }
  .cinema--on .cinema__cue-line {
    transform-origin: top;
    animation: scroll-pulse 2.4s var(--ease-smooth) infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }
</style>
