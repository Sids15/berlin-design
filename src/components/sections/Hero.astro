---
/**
 * Hero (Sections 18, 20, 24) — scroll-driven, frame-by-frame.
 *
 * A full-screen <canvas> is pinned while the visitor scrolls a tall stage;
 * scroll position selects a frame from a pre-decoded WebP sequence and draws
 * it (cover-fit). This is smooth and identical on every device — no video-seek
 * jank. Type sits on the left over a scrim and fades out toward the end, where
 * an overlay eases to full black, handing off into the next (dark) section.
 *
 * Frames come from scripts/extract-frames.mjs. Re-run it when the footage
 * changes and update FRAME_COUNT below.
 *
 * PLACEHOLDER MEDIA: frames derived from a placeholder pour clip — marked for
 * swap with the final art-directed footage.
 */
import { brand, contact } from "../../data/site";
import Button from "../ui/Button.astro";

const FRAME_COUNT = 130; // keep in sync with scripts/extract-frames.mjs
const FRAME_DIR = "/videos/hero/frames"; // @swap: regenerate from final footage
---

<section
  id="top"
  class="hero mode-night"
  aria-label="Berlin — Haus de Gourmet"
  data-hero
  data-frame-count={FRAME_COUNT}
  data-frame-dir={FRAME_DIR}
>
  <div class="hero__sticky">
    <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__inner container--xl">
      <div class="hero__content" data-hero-content>
        <p class="hero__eyebrow">{contact.address.line2}</p>

        <h1 class="hero__headline">
          <span class="hero__line">Dining.</span>
          <span class="hero__line">Drinking.</span>
          <span class="hero__line hero__line--accent">Nights.</span>
        </h1>

        <p class="hero__sub">A rooftop gourmet house<br />above the city.</p>

        <div class="hero__actions">
          <Button href="#visit" variant="primary" arrow={false}>Reserve a Table</Button>
          <Button href="#experience" variant="secondary">Explore</Button>
        </div>

        <dl class="hero__meta">
          <div class="hero__meta-item">
            <svg class="hero__meta-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.25" />
              <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div>
              <dt class="visually-hidden">Hours</dt>
              <dd class="hero__meta-value">12:00 PM – 11:30 PM</dd>
              <dd class="hero__meta-label">Everyday</dd>
            </div>
          </div>

          <span class="hero__meta-divider" aria-hidden="true"></span>

          <div class="hero__meta-item">
            <svg class="hero__meta-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 21s7-5.686 7-11a7 7 0 1 0-14 0c0 5.314 7 11 7 11Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" />
              <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.25" />
            </svg>
            <div>
              <dt class="visually-hidden">Address</dt>
              <dd class="hero__meta-value">{contact.address.line1}</dd>
              <dd class="hero__meta-label">{contact.address.line2}</dd>
            </div>
          </div>
        </dl>
      </div>
    </div>

    <a class="hero__scroll" href="#experience">
      <span class="hero__scroll-label">Scroll to begin</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>

    <div class="hero__endfade" data-hero-endfade aria-hidden="true"></div>
  </div>

  <span class="visually-hidden">{brand.description}</span>
</section>

<script>
  const stage = document.querySelector<HTMLElement>("[data-hero]");
  const canvas = stage?.querySelector<HTMLCanvasElement>("[data-hero-canvas]");
  const content = stage?.querySelector<HTMLElement>("[data-hero-content]");
  const endfade = stage?.querySelector<HTMLElement>("[data-hero-endfade]");

  if (stage && canvas) {
    const ctx = canvas.getContext("2d");
    const count = Number(stage.dataset.frameCount) || 0;
    const dir = stage.dataset.frameDir ?? "";
    const frameUrl = (i: number) =>
      `${dir}/frame-${String(i + 1).padStart(4, "0")}.webp`;

    const clamp01 = (n: number) => Math.min(Math.max(n, 0), 1);
    const smooth = (v: number, a: number, b: number) => clamp01((v - a) / (b - a));

    // --- Draw one frame, cover-fit, in device pixels ---
    let drawn = -1;
    const drawFrame = (index: number) => {
      const img = images[index];
      if (!ctx || !img || !img.complete || img.naturalWidth === 0) return;
      const cw = canvas.width;
      const ch = canvas.height;
      const scale = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const dw = img.naturalWidth * scale;
      const dh = img.naturalHeight * scale;
      ctx.drawImage(img, (cw - dw) / 2, (ch - dh) / 2, dw, dh);
      drawn = index;
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(canvas.clientWidth * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      const redraw = drawn >= 0 ? drawn : 0;
      drawn = -1;
      drawFrame(redraw);
    };

    // --- Preload frames (sequential = matches scroll order) ---
    const images: HTMLImageElement[] = [];
    let loadedCount = 0;
    let highestReady = -1;
    const prefersReduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const nearestReady = (index: number) =>
      index <= highestReady ? index : Math.max(highestReady, 0);

    for (let i = 0; i < count; i++) {
      const img = new Image();
      img.decoding = "async";
      img.onload = () => {
        loadedCount++;
        // frames load in order; track the contiguous ready prefix
        while (highestReady + 1 < count && images[highestReady + 1]?.complete) {
          highestReady++;
        }
        if (i === 0) {
          resize();
          drawFrame(0);
        }
      };
      img.src = frameUrl(i);
      images[i] = img;
    }

    // Size the canvas immediately, independent of image load order.
    resize();

    if (prefersReduced) {
      // Static: hold the first frame, flat layout, no scrubbing.
      stage.classList.add("hero--flat");
      window.addEventListener("resize", resize);
    } else {
      // --- Scroll scrub ---
      let current = 0;
      let running = false;
      let frame = 0;

      const progress = () => {
        const travel = stage.offsetHeight - window.innerHeight;
        return travel > 0
          ? clamp01(-stage.getBoundingClientRect().top / travel)
          : 0;
      };

      const render = () => {
        const target = progress() * (count - 1);
        current += (target - current) * 0.16; // ease toward scroll position
        if (Math.abs(target - current) < 0.25) current = target;

        const index = nearestReady(Math.round(current));
        if (index !== drawn) drawFrame(index);

        const p = target / (count - 1);
        if (content) content.style.opacity = String(1 - smooth(p, 0.7, 0.92));
        if (endfade) endfade.style.opacity = String(smooth(p, 0.74, 1));

        if (Math.abs(target - current) > 0.25) {
          frame = requestAnimationFrame(render);
        } else {
          running = false;
        }
      };

      const kick = () => {
        if (!running) {
          running = true;
          frame = requestAnimationFrame(render);
        }
      };

      window.addEventListener("resize", () => {
        resize();
        kick();
      });

      // Animate only while the hero is on screen.
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            window.addEventListener("scroll", kick, { passive: true });
            kick();
          } else {
            window.removeEventListener("scroll", kick);
            cancelAnimationFrame(frame);
            running = false;
          }
        },
        { threshold: 0 }
      );
      io.observe(stage);
    }
  }
</script>

<style>
  /* --- Scroll stage ------------------------------------------------------- */
  .hero {
    position: relative;
    height: var(--hero-scroll, 300vh); /* longer = slower scrub */
    background-color: var(--color-void);
  }

  .hero--flat {
    height: 100svh;
  }

  .hero__sticky {
    position: sticky;
    inset-block-start: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    isolation: isolate;
  }

  .hero--flat .hero__sticky {
    position: relative;
  }

  /* --- Canvas (full-bleed) ------------------------------------------------ */
  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    display: block;
    filter: brightness(0.9) contrast(1.05) saturate(0.96);
  }

  /* Left column stays dark for legible type; gentle top/bottom fades. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to right, var(--color-void) 0%, rgba(9, 9, 8, 0.55) 26%, rgba(9, 9, 8, 0) 66%),
      linear-gradient(to top, var(--color-void) 0%, rgba(9, 9, 8, 0) 24%),
      linear-gradient(to bottom, rgba(9, 9, 8, 0.5) 0%, rgba(9, 9, 8, 0) 18%);
  }

  /* --- Content ------------------------------------------------------------ */
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero__content {
    max-width: 38rem;
    will-change: opacity;
  }

  .hero__eyebrow {
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    animation: hero-rise 1000ms var(--ease-out) 80ms both;
  }

  .hero__eyebrow::after {
    content: "";
    display: block;
    width: 2.75rem;
    height: 1px;
    margin-block-start: var(--space-16);
    background: var(--accent-muted);
  }

  .hero__headline {
    margin-block-start: clamp(1.75rem, 4vh, 2.75rem);
    font-size: var(--fs-display-xl);
    line-height: var(--lh-display);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .hero__line {
    display: block;
    animation: hero-rise 1000ms var(--ease-out) both;
  }

  .hero__line:nth-child(1) { animation-delay: 180ms; }
  .hero__line:nth-child(2) { animation-delay: 300ms; }
  .hero__line:nth-child(3) { animation-delay: 420ms; }

  .hero__line--accent {
    color: var(--accent);
  }

  .hero__sub {
    margin-block-start: clamp(1.5rem, 3.5vh, 2.25rem);
    max-width: 22rem;
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.7;
    color: var(--text-muted);
    animation: hero-rise 1000ms var(--ease-out) 540ms both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    margin-block-start: clamp(2rem, 4.5vh, 3rem);
    animation: hero-rise 1000ms var(--ease-out) 660ms both;
  }

  /* --- Meta row ----------------------------------------------------------- */
  .hero__meta {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-block-start: clamp(3rem, 8vh, 5rem);
    animation: hero-rise 1000ms var(--ease-out) 800ms both;
  }

  .hero__meta-item {
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }

  .hero__meta-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    color: var(--accent);
  }

  .hero__meta-value {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  .hero__meta-label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-start: 0.2rem;
  }

  .hero__meta-divider {
    width: 1px;
    align-self: stretch;
    min-height: 2.5rem;
    background: var(--border-subtle);
  }

  /* --- Scroll cue --------------------------------------------------------- */
  .hero__scroll {
    position: absolute;
    z-index: 1;
    inset-block-end: clamp(1.5rem, 4vh, 2.5rem);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-16);
    color: var(--text-muted);
    animation: hero-rise 1000ms var(--ease-out) 960ms both;
  }

  .hero__scroll-label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .hero__scroll-line {
    width: 1px;
    height: clamp(2.5rem, 7vh, 4.5rem);
    background: linear-gradient(to bottom, var(--accent-muted), transparent);
    transform-origin: top;
    animation: scroll-pulse 2.4s var(--ease-smooth) infinite;
  }

  .hero__scroll:hover {
    color: var(--text);
  }

  /* --- End fade to black (handoff to the next section) -------------------- */
  .hero__endfade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--color-void);
    opacity: 0;
    pointer-events: none;
  }

  /* --- Mobile (§24) ------------------------------------------------------- */
  @media (max-width: 48rem) {
    .hero {
      --hero-scroll: 240vh;
    }
    .hero__scrim {
      background:
        linear-gradient(to top, var(--color-void) 8%, rgba(9, 9, 8, 0.3) 55%, rgba(9, 9, 8, 0.72) 100%);
    }
    .hero__headline {
      font-size: var(--fs-display-l);
    }
    .hero__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-24);
    }
    .hero__meta-divider {
      display: none;
    }
    .hero__scroll {
      display: none;
    }
  }

  /* --- Motion (§18) ------------------------------------------------------- */
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes scroll-pulse {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }
</style>
