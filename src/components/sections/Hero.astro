---
/**
 * Hero (Sections 20, 24) — cinematic split composition (reference).
 * Dark left column carries the type; the drink emerges from the void on the
 * right, bleeding to the edge. Establishes the type treatment, CTA language,
 * and meta styling the rest of the site inherits.
 *
 * PLACEHOLDER IMAGE: free-license (Unsplash, no attribution required),
 * marked for swap with the real art-directed photography. Astro's <Picture>
 * emits AVIF/WebP + srcset automatically (Section 26).
 */
import { Picture } from "astro:assets";
import { brand, contact } from "../../data/site";
import Button from "../ui/Button.astro";
// @swap: replace with the final hero photograph (dark background, subject right).
import heroImage from "../../assets/hero/hero-pour-dark.jpg";
---

<section id="top" class="hero mode-night" aria-label="Berlin — Haus de Gourmet">
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={heroImage}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      alt=""
      widths={[768, 1200, 1800, 2400]}
      sizes="(max-width: 48rem) 100vw, 62vw"
      loading="eager"
      fetchpriority="high"
      pictureAttributes={{ class: "hero__picture" }}
      class="hero__image"
    />
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__inner container--xl">
    <div class="hero__content">
      <p class="hero__eyebrow">{contact.address.line2}</p>

      <h1 class="hero__headline">
        <span class="hero__line">Dining.</span>
        <span class="hero__line">Drinking.</span>
        <span class="hero__line hero__line--accent">Nights.</span>
      </h1>

      <p class="hero__sub">A rooftop gourmet house<br />above the city.</p>

      <div class="hero__actions">
        <Button href="#visit" variant="primary" arrow={false}>Reserve a Table</Button>
        <Button href="#experience" variant="secondary">Explore</Button>
      </div>

      <dl class="hero__meta">
        <div class="hero__meta-item">
          <svg class="hero__meta-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.25" />
            <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div>
            <dt class="visually-hidden">Hours</dt>
            <dd class="hero__meta-value">12:00 PM – 11:30 PM</dd>
            <dd class="hero__meta-label">Everyday</dd>
          </div>
        </div>

        <span class="hero__meta-divider" aria-hidden="true"></span>

        <div class="hero__meta-item">
          <svg class="hero__meta-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 21s7-5.686 7-11a7 7 0 1 0-14 0c0 5.314 7 11 7 11Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" />
            <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.25" />
          </svg>
          <div>
            <dt class="visually-hidden">Address</dt>
            <dd class="hero__meta-value">{contact.address.line1}</dd>
            <dd class="hero__meta-label">{contact.address.line2}</dd>
          </div>
        </div>
      </dl>
    </div>
  </div>

  <a class="hero__scroll" href="#experience">
    <span class="hero__scroll-label">Scroll to begin</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>

  <span class="visually-hidden">{brand.description}</span>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-void);
  }

  /* --- Media: emerges from the void on the right (§16) -------------------- */
  .hero__media {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: 62%;
    z-index: -2;
  }

  .hero__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.9) contrast(1.05) saturate(0.96);
    animation: hero-image-in 1400ms var(--ease-out) both;
  }

  /* Melt the image's left edge into the dark column; gentle top/bottom fades. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--color-void) 0%, rgba(9, 9, 8, 0.55) 22%, rgba(9, 9, 8, 0) 58%),
      linear-gradient(to bottom, var(--color-void) 0%, rgba(9, 9, 8, 0) 18%),
      linear-gradient(to top, var(--color-void) 0%, rgba(9, 9, 8, 0) 20%);
  }

  /* --- Content ------------------------------------------------------------ */
  .hero__inner {
    position: relative;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: clamp(7rem, 14vh, 10rem) clamp(3rem, 8vh, 5rem);
  }

  .hero__content {
    max-width: 38rem;
  }

  .hero__eyebrow {
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    animation: hero-rise 1000ms var(--ease-out) 80ms both;
  }

  .hero__eyebrow::after {
    content: "";
    display: block;
    width: 2.75rem;
    height: 1px;
    margin-block-start: var(--space-16);
    background: var(--accent-muted);
  }

  .hero__headline {
    margin-block-start: clamp(1.75rem, 4vh, 2.75rem);
    font-size: var(--fs-display-xl);
    line-height: var(--lh-display);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .hero__line {
    display: block;
    animation: hero-rise 1000ms var(--ease-out) both;
  }

  .hero__line:nth-child(1) { animation-delay: 180ms; }
  .hero__line:nth-child(2) { animation-delay: 300ms; }
  .hero__line:nth-child(3) { animation-delay: 420ms; }

  .hero__line--accent {
    color: var(--accent);
  }

  .hero__sub {
    margin-block-start: clamp(1.5rem, 3.5vh, 2.25rem);
    max-width: 22rem;
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.7;
    color: var(--text-muted);
    animation: hero-rise 1000ms var(--ease-out) 540ms both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    margin-block-start: clamp(2rem, 4.5vh, 3rem);
    animation: hero-rise 1000ms var(--ease-out) 660ms both;
  }

  /* --- Meta row (printed-stationery feel, §7) ----------------------------- */
  .hero__meta {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-block-start: clamp(3rem, 8vh, 5rem);
    animation: hero-rise 1000ms var(--ease-out) 800ms both;
  }

  .hero__meta-item {
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }

  .hero__meta-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    color: var(--accent);
  }

  .hero__meta-value {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  .hero__meta-label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-start: 0.2rem;
  }

  .hero__meta-divider {
    width: 1px;
    align-self: stretch;
    min-height: 2.5rem;
    background: var(--border-subtle);
  }

  /* --- Scroll cue --------------------------------------------------------- */
  .hero__scroll {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-16);
    color: var(--text-muted);
    animation: hero-rise 1000ms var(--ease-out) 960ms both;
  }

  .hero__scroll-label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .hero__scroll-line {
    width: 1px;
    height: clamp(2.5rem, 7vh, 4.5rem);
    background: linear-gradient(to bottom, var(--accent-muted), transparent);
    transform-origin: top;
    animation: scroll-pulse 2.4s var(--ease-smooth) infinite;
  }

  .hero__scroll:hover {
    color: var(--text);
  }

  /* --- Mobile (§24): full-bleed image, text over a full scrim ------------- */
  @media (max-width: 48rem) {
    .hero__media {
      width: 100%;
    }
    .hero__scrim {
      background:
        linear-gradient(to top, var(--color-void) 8%, rgba(9, 9, 8, 0.3) 55%, rgba(9, 9, 8, 0.72) 100%);
    }
    .hero__headline {
      font-size: var(--fs-display-l);
    }
    .hero__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-24);
    }
    .hero__meta-divider {
      display: none;
    }
    .hero__scroll {
      display: none;
    }
  }

  /* --- Motion (§18) ------------------------------------------------------- */
  @keyframes hero-image-in {
    from { opacity: 0; transform: scale(1.05); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes scroll-pulse {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }
</style>
