---
/**
 * Hero — the opening pour (Sections 18, 20, 24).
 *
 * A pinned scroll stage scrubs a WebP frame sequence: the pour plays as you
 * scroll and freezes on its final frame (the branded glass, centred on black).
 * The pin then releases and the site flows on from black into The Experience.
 *
 * Hero copy sits on the left over a scrim and fades as the glass takes centre.
 * Progressive enhancement: static first-frame fallback; reduced-motion holds a
 * still. Driven by src/scripts/cinema.ts (GSAP ScrollTrigger + Lenis).
 *
 * PLACEHOLDER MEDIA: frames from a placeholder pour clip (`npm run frames`).
 */
import { brand, contact } from "../../data/site";
import Button from "../ui/Button.astro";

// The pour sequence has 130 frames on disk (~10s). The hero scrubs only the
// first ~4 seconds (≈52 frames), resting on the filled, branded glass; the
// later frames are still used by The Bar and the Moments gallery.
const FRAME_COUNT = 52;
const FRAME_DIR = "/videos/hero/frames";
---

<section
  id="top"
  class="hero mode-night"
  aria-label="Berlin — Haus de Gourmet"
  data-hero
  data-frame-count={FRAME_COUNT}
  data-frame-dir={FRAME_DIR}
>
  <div class="hero__pin" data-hero-pin>
    <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__inner container--xl">
      <div class="hero__copy" data-hero-copy>
        <p class="hero__eyebrow">{contact.address.line2}</p>
        <h1 class="hero__headline">
          <span class="hero__line">Dining.</span>
          <span class="hero__line">Drinking.</span>
          <span class="hero__line hero__line--accent">Nights.</span>
        </h1>
        <p class="hero__sub">A rooftop gourmet house<br />above the city.</p>
        <div class="hero__actions">
          <Button href="#visit" variant="primary" arrow={false} data-magnetic="0.25">Reserve a Table</Button>
          <Button href="#experience" variant="secondary">Explore</Button>
        </div>
        <dl class="hero__meta">
          <div class="hero__meta-item">
            <svg class="hero__meta-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.25" />
              <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div>
              <dt class="visually-hidden">Hours</dt>
              <dd class="hero__meta-value">12:00 PM – 11:30 PM</dd>
              <dd class="hero__meta-label">Everyday</dd>
            </div>
          </div>
          <span class="hero__meta-divider" aria-hidden="true"></span>
          <div class="hero__meta-item">
            <svg class="hero__meta-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 21s7-5.686 7-11a7 7 0 1 0-14 0c0 5.314 7 11 7 11Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" />
              <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.25" />
            </svg>
            <div>
              <dt class="visually-hidden">Address</dt>
              <dd class="hero__meta-value">{contact.address.line1}</dd>
              <dd class="hero__meta-label">{contact.address.line2}</dd>
            </div>
          </div>
        </dl>
      </div>
    </div>

    <a class="hero__cue" href="#experience" data-hero-copy>
      <span class="hero__cue-label">Scroll to begin</span>
      <span class="hero__cue-line" aria-hidden="true"></span>
    </a>
  </div>

  <span class="visually-hidden">{brand.description}</span>
</section>

<script>
  import { initCinema } from "../../scripts/cinema";
  initCinema();
</script>

<style>
  .hero {
    position: relative;
    background-color: var(--color-void);
  }

  .hero__pin {
    position: relative;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: block;
    filter: brightness(0.92) contrast(1.05) saturate(0.96);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(to right, var(--color-void) 0%, rgba(9, 9, 8, 0.5) 26%, rgba(9, 9, 8, 0) 66%),
      linear-gradient(to top, var(--color-void) 0%, rgba(9, 9, 8, 0) 22%);
  }

  .hero__inner {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    margin-inline: auto;
    padding-inline: var(--gutter);
    /* Keep the copy clear of the fixed header and the bottom cue. */
    padding-block: clamp(6rem, 13vh, 9rem) clamp(4rem, 12vh, 7rem);
  }

  .hero__copy {
    max-width: 38rem;
    will-change: opacity, transform;
  }

  .hero__eyebrow {
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    animation: hero-rise 1000ms var(--ease-out) 80ms both;
  }

  .hero__eyebrow::after {
    content: "";
    display: block;
    width: 2.75rem;
    height: 1px;
    margin-block-start: var(--space-16);
    background: var(--accent-muted);
  }

  .hero__headline {
    margin-block-start: clamp(1.25rem, 3.5vh, 2.75rem);
    /* Cap by viewport height too, so a short/wide window can't overflow it
       up under the header. */
    font-size: clamp(3rem, min(9vw, 15vh), 8rem);
    line-height: var(--lh-display);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .hero__line {
    display: block;
    animation: hero-rise 1000ms var(--ease-out) both;
  }

  .hero__line:nth-child(1) { animation-delay: 180ms; }
  .hero__line:nth-child(2) { animation-delay: 300ms; }
  .hero__line:nth-child(3) { animation-delay: 420ms; }
  .hero__line--accent { color: var(--accent); }

  .hero__sub {
    margin-block-start: clamp(1.5rem, 3.5vh, 2.25rem);
    max-width: 22rem;
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.7;
    color: var(--text-muted);
    animation: hero-rise 1000ms var(--ease-out) 540ms both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    margin-block-start: clamp(2rem, 4.5vh, 3rem);
    animation: hero-rise 1000ms var(--ease-out) 660ms both;
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-block-start: clamp(3rem, 8vh, 5rem);
    animation: hero-rise 1000ms var(--ease-out) 800ms both;
  }
  .hero__meta-item { display: flex; align-items: center; gap: var(--space-16); }
  .hero__meta-icon { width: 1.5rem; height: 1.5rem; flex-shrink: 0; color: var(--accent); }
  .hero__meta-value {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }
  .hero__meta-label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-start: 0.2rem;
  }
  .hero__meta-divider {
    width: 1px;
    align-self: stretch;
    min-height: 2.5rem;
    background: var(--border-subtle);
  }

  .hero__cue {
    position: absolute;
    z-index: 2;
    inset-block-end: clamp(1.5rem, 4vh, 2.5rem);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-16);
    color: var(--text-muted);
    animation: hero-rise 1000ms var(--ease-out) 960ms both;
  }
  .hero__cue-label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .hero__cue-line {
    width: 1px;
    height: clamp(2.5rem, 7vh, 4.5rem);
    background: linear-gradient(to bottom, var(--accent-muted), transparent);
    transform-origin: top;
    animation: scroll-pulse 2.4s var(--ease-smooth) infinite;
  }
  .hero__cue:hover { color: var(--text); }

  @media (max-width: 48rem) {
    .hero__headline { font-size: var(--fs-display-l); }
    .hero__scrim {
      background: linear-gradient(to top, var(--color-void) 8%, rgba(9, 9, 8, 0.3) 55%, rgba(9, 9, 8, 0.72) 100%);
    }
    .hero__meta { flex-direction: column; align-items: flex-start; gap: var(--space-24); }
    .hero__meta-divider { display: none; }
    .hero__cue { display: none; }
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes scroll-pulse {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }
</style>
