---
/**
 * The Bar (04) — the branded glass on a spotlit stage, the signature pours
 * flanking it left and right. A symmetrical, product-forward composition,
 * distinct from the side-by-side splits elsewhere. Reuses a hero pour frame.
 */
import SectionLabel from "../ui/SectionLabel.astro";
import Button from "../ui/Button.astro";

const left = [
  { name: "Old Fashioned", note: "Bourbon · bitters · orange" },
  { name: "Smoked Negroni", note: "Gin · campari · oak smoke" },
];
const right = [
  { name: "Rooftop Spritz", note: "Aperol · prosecco · citrus" },
  { name: "Rare Single Malts", note: "Curated by region" },
];
---

<section id="bar" class="bar mode-night" data-journey-section>
  <div class="bar__inner container--xl">
    <SectionLabel index="04" class="bar__label" data-reveal>The Bar</SectionLabel>
    <h2 class="bar__headline" data-split>
      Crafted cocktails, <em>curated spirits.</em>
    </h2>

    <div class="bar__stage">
      <ul class="bar__pours bar__pours--left">
        {left.map((p) => (
          <li class="bar__pour" data-reveal>
            <span class="bar__pour-name">{p.name}</span>
            <span class="bar__pour-note">{p.note}</span>
          </li>
        ))}
      </ul>

      <figure class="bar__glass">
        <span class="bar__glow" aria-hidden="true"></span>
        <img
          class="bar__img"
          src="/videos/hero/frames/frame-0128.webp"
          width="1200"
          height="1500"
          loading="lazy"
          decoding="async"
          alt="The signature Berlin glass — whisky over ice, etched crystal"
          data-clip
        />
      </figure>

      <ul class="bar__pours bar__pours--right">
        {right.map((p) => (
          <li class="bar__pour" data-reveal>
            <span class="bar__pour-name">{p.name}</span>
            <span class="bar__pour-note">{p.note}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="bar__copy" data-reveal>
      A full bar under low light — signature cocktails, a considered spirits
      list, and a room that hums a little louder as the night goes on.
    </p>
    <div class="bar__cta" data-reveal>
      <Button href="#after-dark" variant="secondary">Explore after dark</Button>
    </div>
  </div>
</section>

<style>
  .bar {
    background-color: var(--color-warm-black);
    padding-block: var(--space-section-cinematic);
    overflow: clip;
  }

  .bar__inner {
    margin-inline: auto;
    padding-inline: var(--gutter);
    max-width: var(--container-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .bar__headline {
    margin-block-start: var(--space-24);
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--fs-display-m);
    line-height: 1.04;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }
  .bar__headline em { font-style: italic; color: var(--accent); }

  /* Stage: pours | glass | pours */
  .bar__stage {
    margin-block-start: clamp(2.5rem, 6vh, 4.5rem);
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .bar__pours {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 4vh, 3rem);
  }
  .bar__pour { display: flex; flex-direction: column; gap: 0.4rem; }
  .bar__pour-name {
    font-family: var(--font-display);
    font-size: var(--fs-heading-m);
    line-height: 1.1;
    color: var(--text-strong);
  }
  .bar__pour-note {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .bar__glass {
    position: relative;
    margin: 0;
    width: min(20rem, 66vw);
    aspect-ratio: 3 / 4;
  }
  .bar__glow {
    position: absolute;
    inset: -25% -40%;
    z-index: -1;
    background: radial-gradient(50% 50% at 50% 46%, rgba(180, 154, 99, 0.24) 0%, rgba(9, 9, 8, 0) 70%);
  }
  .bar__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    background: var(--color-void);
  }

  .bar__copy {
    margin-block-start: clamp(2.5rem, 6vh, 4rem);
    max-width: 34rem;
    font-size: var(--fs-body-l);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }
  .bar__cta { margin-block-start: var(--space-40); }

  @media (min-width: 60rem) {
    .bar__stage {
      grid-template-columns: 1fr auto 1fr;
    }
    .bar__pours--left { text-align: right; justify-self: end; }
    .bar__pours--right { text-align: left; justify-self: start; }
  }
</style>
