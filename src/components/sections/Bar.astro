---
/**
 * The Bar (04) — an interactive cocktail menu. A vertical list of signature
 * pours; hovering (or focusing) one swaps in its photograph and recipe on the
 * left. Dark, literary, product-forward — distinct from every split on the page.
 * PLACEHOLDER IMAGES: free-license (Unsplash), @swap.
 */
import { Image } from "astro:assets";
import SectionLabel from "../ui/SectionLabel.astro";
import Button from "../ui/Button.astro";
import oldFashioned from "../../assets/bar/bar-old-fashioned.jpg";
import negroni from "../../assets/bar/bar-negroni.jpg";
import spritz from "../../assets/bar/bar-spritz.jpg";
import singleMalt from "../../assets/bar/bar-single-malt.jpg";

const cocktails = [
  { name: "Old Fashioned", recipe: "Bourbon · bitters · orange peel", price: "₹680", img: oldFashioned },
  { name: "Smoked Negroni", recipe: "Gin · campari · oak smoke", price: "₹720", img: negroni },
  { name: "Rooftop Spritz", recipe: "Aperol · prosecco · citrus", price: "₹620", img: spritz },
  { name: "Rare Single Malts", recipe: "Curated by region", price: "₹900+", img: singleMalt },
];
---

<section id="bar" class="bar mode-night section" data-journey-section data-bar>
  <div class="bar__inner container--xl">
    <div class="bar__head">
      <SectionLabel index="04" data-reveal>The Bar</SectionLabel>
      <h2 class="bar__title" data-split>Crafted cocktails,<br /><em>curated spirits.</em></h2>
      <p class="bar__intro" data-reveal>
        A full bar under low light. Hover a pour to see it made.
      </p>
    </div>

    <div class="bar__menu">
      <div class="bar__gallery" data-reveal>
        {cocktails.map((c, i) => (
          <figure class:list={["bar__shot", { "is-active": i === 0 }]} data-bar-shot>
            <Image
              class="bar__shot-img"
              src={c.img}
              alt={c.name}
              widths={[500, 800]}
              sizes="(max-width: 60rem) 100vw, 40vw"
              loading="lazy"
            />
            <figcaption class="bar__shot-cap">
              <span class="bar__shot-recipe">{c.recipe}</span>
              <span class="bar__shot-price">{c.price}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <ul class="bar__list" data-reveal>
        {cocktails.map((c, i) => (
          <li>
            <button
              type="button"
              class:list={["bar__item", { "is-active": i === 0 }]}
              data-bar-item
              data-cursor
            >
              <span class="bar__item-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="bar__item-name">{c.name}</span>
              <span class="bar__item-arrow" aria-hidden="true">→</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="bar__cta" data-reveal>
      <Button href="#after-dark" variant="secondary" data-magnetic="0.3">Explore after dark</Button>
    </div>
  </div>
</section>

<script>
  const bar = document.querySelector<HTMLElement>("[data-bar]");
  if (bar) {
    const items = Array.from(bar.querySelectorAll<HTMLElement>("[data-bar-item]"));
    const shots = Array.from(bar.querySelectorAll<HTMLElement>("[data-bar-shot]"));
    const activate = (i: number) => {
      shots.forEach((s, j) => s.classList.toggle("is-active", j === i));
      items.forEach((it, j) => it.classList.toggle("is-active", j === i));
    };
    items.forEach((item, i) => {
      item.addEventListener("mouseenter", () => activate(i));
      item.addEventListener("focus", () => activate(i));
      item.addEventListener("click", () => activate(i));
    });
  }
</script>

<style>
  .bar {
    background-color: var(--color-warm-black);
    overflow: clip;
  }

  .bar__inner {
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .bar__head { max-width: 40rem; }
  .bar__title {
    margin-block-start: var(--space-24);
    font-family: var(--font-display);
    font-size: var(--fs-display-m);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }
  .bar__title em { font-style: italic; color: var(--accent); }
  .bar__intro {
    margin-block-start: var(--space-24);
    font-size: var(--fs-body-l);
    color: var(--text-muted);
  }

  .bar__menu {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: stretch;
  }

  /* Gallery — stacked shots, only the active one visible */
  .bar__gallery {
    position: relative;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    background: var(--color-void);
  }
  .bar__shot {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.7s var(--ease-out), transform 0.9s var(--ease-out);
  }
  .bar__shot.is-active {
    opacity: 1;
    transform: scale(1);
  }
  .bar__shot-img { width: 100%; height: 100%; object-fit: cover; }
  .bar__shot-cap {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-16);
    padding: var(--space-24);
    background: linear-gradient(to top, rgba(9, 9, 8, 0.85), rgba(9, 9, 8, 0));
  }
  .bar__shot-recipe {
    font-size: var(--fs-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
  }
  .bar__shot-price {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--accent);
  }

  /* List */
  .bar__list { display: flex; flex-direction: column; }
  .bar__item {
    width: 100%;
    display: flex;
    align-items: baseline;
    gap: var(--space-16);
    padding-block: clamp(1rem, 2.5vh, 1.75rem);
    border-block-start: 1px solid var(--border-subtle);
    text-align: left;
    color: var(--text-muted);
    transition: color 0.4s var(--ease-out), padding-inline-start 0.4s var(--ease-out);
  }
  .bar__list li:last-child .bar__item { border-block-end: 1px solid var(--border-subtle); }
  .bar__item-index {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    opacity: 0.7;
  }
  .bar__item-name {
    flex: 1;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.1;
    color: inherit;
    transition: color 0.4s var(--ease-out);
  }
  .bar__item-arrow {
    opacity: 0;
    transform: translateX(-8px);
    color: var(--accent);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .bar__item:hover,
  .bar__item:focus-visible,
  .bar__item.is-active {
    color: var(--text-strong);
    padding-inline-start: var(--space-16);
  }
  .bar__item.is-active .bar__item-arrow,
  .bar__item:hover .bar__item-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .bar__item.is-active .bar__item-index { opacity: 1; }

  .bar__cta { margin-block-start: clamp(2.5rem, 5vw, 4rem); }

  @media (min-width: 60rem) {
    .bar__menu { grid-template-columns: 0.9fr 1.1fr; }
    .bar__gallery { position: sticky; top: 12vh; }
  }
</style>
