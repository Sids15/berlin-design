---
/**
 * The Experience (Sections 20, 21) — editorial split. Rises from the hero's
 * black on the left with the statement + intro; a tall interior frame anchors
 * the right. First flowing section after the pinned opening.
 *
 * PLACEHOLDER IMAGE: free-license (Unsplash), marked @swap.
 */
import { Picture } from "astro:assets";
import SectionLabel from "../ui/SectionLabel.astro";
import Button from "../ui/Button.astro";
// @swap: final interior photograph (warm, architectural).
import interior from "../../assets/experience/experience-interior.jpg";
---

<section id="experience" class="exp section mode-night" data-journey-section>
  <div class="exp__grid container--xl">
    <div class="exp__text">
      <SectionLabel index="01" class="exp__label" data-reveal>The Experience</SectionLabel>

      <h2 class="exp__statement" data-reveal>
        Long evenings,<br />good company,<br /><em>great flavours.</em>
      </h2>

      <p class="exp__copy" data-reveal>
        Berlin is a rooftop gourmet house and bar six floors above Vijay Nagar —
        a place where global flavours meet crafted cocktails, and the city lights
        set the mood. The evening is unhurried here, and made to be remembered.
      </p>

      <div class="exp__cta" data-reveal>
        <Button href="#rooftop" variant="secondary">Discover the rooftop</Button>
      </div>
    </div>

    <figure class="exp__figure" data-reveal>
      <Picture
        src={interior}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        alt="The warm, candlelit interior of Berlin — Haus de Gourmet at night"
        widths={[600, 900, 1400]}
        sizes="(max-width: 60rem) 100vw, 45vw"
        class="exp__image"
      />
      <figcaption class="exp__figcaption">Level 06 · High Street Apollo</figcaption>
    </figure>
  </div>
</section>

<style>
  .exp {
    background-color: var(--color-void);
    overflow: clip;
  }

  .exp__grid {
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .exp__text {
    max-width: 34rem;
  }

  .exp__statement {
    margin-block-start: var(--space-32);
    font-family: var(--font-display);
    font-size: var(--fs-display-m);
    line-height: 1.03;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }
  .exp__statement em {
    font-style: italic;
    color: var(--accent);
  }

  .exp__copy {
    margin-block-start: var(--space-32);
    font-size: var(--fs-body-l);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  .exp__cta {
    margin-block-start: var(--space-40);
  }

  .exp__figure {
    position: relative;
    margin: 0;
  }

  .exp__image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
  }

  .exp__figcaption {
    margin-block-start: var(--space-16);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Editorial split on wider screens — text narrow, image tall and offset. */
  @media (min-width: 60rem) {
    .exp__grid {
      grid-template-columns: 1fr 0.85fr;
    }
    .exp__figure {
      justify-self: end;
      max-width: 34rem;
    }
  }
</style>
