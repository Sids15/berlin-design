---
/**
 * BaseLayout — document shell. Loads self-hosted variable fonts (Section 5),
 * global styles, and sensible SEO/meta defaults.
 */
import "@fontsource-variable/bodoni-moda";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import { brand, contact } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${brand.name} — ${brand.tagline}`,
  description = brand.description,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090908" />

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_IN" />

    <!-- Structured data for a real, physical restaurant -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Restaurant",
        name: `${brand.name} — ${brand.tagline}`,
        servesCuisine: ["Pan-Asian", "Continental", "North Indian", "Mediterranean"],
        priceRange: "$$$",
        telephone: contact.phoneDisplay,
        openingHours: "Mo-Su 12:00-23:30",
        address: {
          "@type": "PostalAddress",
          streetAddress: `${contact.address.line1}, ${contact.address.line2}`,
          addressRegion: "Madhya Pradesh",
          postalCode: "452010",
          addressCountry: "IN",
        },
      })}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
