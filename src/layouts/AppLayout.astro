---
/**
 * AppLayout — document shell for the ordering app (menu, order tracking, staff,
 * kitchen). Shares the design system (tokens + fonts) with the marketing site,
 * but is its own lean shell: no marketing chrome, app pages are server-rendered.
 */
import "@fontsource-variable/bodoni-moda";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import { brand } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Ordering-app pages should not be indexed. */
  noindex?: boolean;
}

const {
  title = `${brand.name} — Order`,
  description = "Order at Berlin — Haus de Gourmet.",
  noindex = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090908" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body class="app mode-night">
    <slot />
  </body>
</html>

<style>
  .app {
    min-height: 100svh;
    background-color: var(--color-void);
    color: var(--text);
  }
</style>
