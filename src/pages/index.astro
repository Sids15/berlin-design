---
/**
 * Home — the single-page arrival → after-dark journey.
 * The hero pours and freezes, then the evening flows on through the sections.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import SectionIndex from "../components/layout/SectionIndex.astro";
import MobileActionBar from "../components/layout/MobileActionBar.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Experience from "../components/sections/Experience.astro";
import Rooftop from "../components/sections/Rooftop.astro";
import Dining from "../components/sections/Dining.astro";
import Bar from "../components/sections/Bar.astro";
import AfterDark from "../components/sections/AfterDark.astro";
import Menu from "../components/sections/Menu.astro";
import Reviews from "../components/sections/Reviews.astro";
import Reservation from "../components/sections/Reservation.astro";
---

<BaseLayout>
  <Header />
  <SectionIndex />
  <main>
    <Hero />
    <Experience />
    <Rooftop />
    <Dining />
    <Bar />
    <AfterDark />
    <Menu />
    <Reviews />
    <Reservation />
  </main>
  <Footer />
  <MobileActionBar />
</BaseLayout>
