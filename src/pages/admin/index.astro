---
/**
 * Manager menu panel (Feature 6). Manager-only (role-gated by the middleware).
 * Lists every dish by category with edit/delete; add a new dish. Category CRUD
 * lands next. Writes go through the authenticated client — RLS enforces manager.
 */
import AppLayout from "../../layouts/AppLayout.astro";
import { getAdminMenu } from "../../lib/menu/admin";
import { formatINR } from "../../lib/money";

export const prerender = false;

const { supabase } = Astro.locals;
const menu = await getAdminMenu(supabase);

const params = Astro.url.searchParams;
const ok = params.get("ok"); // created | saved | deleted
const err = params.get("err");
const OK_COPY: Record<string, string> = {
  created: "Dish created.",
  saved: "Dish saved.",
  deleted: "Dish deleted.",
  "cat-created": "Category created.",
  "cat-saved": "Category saved.",
  "cat-deleted": "Category deleted.",
};
---

<AppLayout title="Menu manager — Berlin">
  <main class="admin">
    <header class="admin__bar">
      <div>
        <p class="admin__eyebrow">Berlin · Manager</p>
        <h1 class="admin__title">Menu manager</h1>
      </div>
      <div class="admin__actions">
        <a class="admin__link" href="/staff">← Order desk</a>
        <a class="admin__add" href="/admin/items/new">+ Add dish</a>
      </div>
    </header>

    {(ok || err) && (
      <div class="toaster" aria-live="polite">
        {ok && <p class="toast toast--ok" data-toast data-ttl="3200">{OK_COPY[ok] ?? "Done."}</p>}
        {err && <p class="toast toast--err" role="alert" data-toast data-ttl="6000">{err}</p>}
      </div>
    )}

    {menu.length === 0 ? (
      <p class="admin__empty">No categories yet. Category management is coming next.</p>
    ) : (
      menu.map((cat) => (
        <section class="cat">
          <h2 class="cat__name">{cat.name}</h2>
          {cat.items.length === 0 ? (
            <p class="cat__empty">No dishes in this category.</p>
          ) : (
            <ul class="cat__list">
              {cat.items.map((i) => (
                <li class={`drow ${i.is_available ? "" : "drow--off"}`}>
                  <span class={`drow__dot drow__dot--${i.veg_type}`} aria-hidden="true" />
                  <span class="drow__name">
                    {i.name}
                    {i.is_signature && <span class="drow__sig">Signature</span>}
                    {!i.is_available && <span class="drow__off">86'd</span>}
                  </span>
                  <span class="drow__price">{formatINR(i.price)}</span>
                  <a class="drow__edit" href={`/admin/items/${i.id}`}>Edit</a>
                  <form method="post" action={`/api/admin/items/${i.id}`} class="drow__delform">
                    <input type="hidden" name="action" value="delete" />
                    <button type="submit" class="drow__del">Delete</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    )}

    <section class="cats">
      <h2 class="cats__title">Categories</h2>
      <ul class="cats__list">
        {menu.map((c) => (
          <li class="crow">
            <form class="crow__edit" method="post" action={`/api/admin/categories/${c.id}`}>
              <input type="hidden" name="action" value="update" />
              <input class="crow__name" type="text" name="name" value={c.name} aria-label="Category name" />
              <input class="crow__sort" type="number" name="sort_order" value={c.sort_order} aria-label="Sort order" />
              <button class="crow__save" type="submit">Save</button>
            </form>
            <span class="crow__count">{c.items.length} {c.items.length === 1 ? "dish" : "dishes"}</span>
            <form method="post" action={`/api/admin/categories/${c.id}`}>
              <input type="hidden" name="action" value="delete" />
              <button class="crow__del" type="submit" disabled={c.items.length > 0}
                title={c.items.length > 0 ? "Move or delete its dishes first" : "Delete category"}>
                Delete
              </button>
            </form>
          </li>
        ))}
      </ul>

      <form class="catnew" method="post" action="/api/admin/categories/new">
        <input class="crow__name" type="text" name="name" placeholder="New category name" required />
        <input class="crow__sort" type="number" name="sort_order" value={menu.length} aria-label="Sort order" />
        <button class="catnew__add" type="submit">+ Add category</button>
      </form>
    </section>
  </main>
</AppLayout>

<script>
  // Auto-dismiss each toast after its TTL, then clean the ?ok/?err from the URL
  // so a refresh doesn't replay the message.
  for (const el of document.querySelectorAll<HTMLElement>("[data-toast]")) {
    const ttl = Number(el.dataset.ttl) || 3200;
    window.setTimeout(() => {
      el.classList.add("toast--hide");
      el.addEventListener("animationend", () => el.remove(), { once: true });
    }, ttl);
  }
  if (location.search) {
    history.replaceState(null, "", location.pathname);
  }
</script>

<style>
  .admin {
    max-width: var(--container-editorial);
    margin-inline: auto;
    padding: var(--space-32) var(--gutter) var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .admin__bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-16);
    padding-block-end: var(--space-24);
    border-bottom: 1px solid var(--border-subtle);
  }
  .admin__eyebrow {
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .admin__title {
    margin-block-start: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    color: var(--text-strong);
  }
  .admin__actions {
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }
  .admin__link {
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .admin__link:hover {
    color: var(--text-strong);
  }
  .admin__add {
    padding: var(--space-8) var(--space-16);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .admin__add:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  /* Toast — rises from the bottom, then dismisses itself. */
  .toaster {
    position: fixed;
    inset-block-end: calc(var(--space-32) + env(safe-area-inset-bottom, 0px));
    inset-inline: 0;
    z-index: var(--z-overlay, 200);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    padding-inline: var(--gutter);
    pointer-events: none;
  }
  .toast {
    pointer-events: auto;
    max-width: min(32rem, 92vw);
    padding: var(--space-16) var(--space-24);
    font-size: var(--fs-caption);
    color: var(--text-strong);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-inline-start: 2px solid var(--accent);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.55);
    animation: toast-in 0.5s var(--ease-out) both;
  }
  .toast--ok {
    border-inline-start-color: #4c8b4a;
  }
  .toast--err {
    border-inline-start-color: var(--color-berlin-red);
  }
  .toast--hide {
    animation: toast-out 0.4s var(--ease-out) forwards;
  }
  @keyframes toast-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes toast-out {
    to { opacity: 0; transform: translateY(18px); }
  }
  .admin__empty {
    padding-block: var(--space-48);
    text-align: center;
    color: var(--text-muted);
  }
  .cat__name {
    font-family: var(--font-display);
    font-size: var(--fs-heading-m);
    color: var(--text-strong);
    padding-block-end: var(--space-12);
    border-bottom: 1px solid var(--border-subtle);
  }
  .cat__empty {
    padding-block: var(--space-16);
    color: var(--text-muted);
    font-size: var(--fs-caption);
  }
  .cat__list {
    display: flex;
    flex-direction: column;
  }
  .drow {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--border-subtle);
  }
  .drow__dot {
    flex: 0 0 auto;
    width: 0.75rem;
    height: 0.75rem;
    border: 1.5px solid currentColor;
    position: relative;
  }
  .drow__dot::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }
  .drow__dot--veg {
    color: #4c8b4a;
  }
  .drow__dot--non_veg {
    color: #a33227;
  }
  .drow__dot--egg {
    color: #b08a3c;
  }
  .drow__name {
    flex: 1 1 auto;
    min-width: 0;
    color: var(--text-strong);
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }
  .drow--off .drow__name {
    color: var(--text-muted);
  }
  .drow__sig {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent-muted);
    padding: 1px var(--space-8);
  }
  .drow__off {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: #c76b60;
    border: 1px solid var(--color-berlin-red);
    padding: 1px var(--space-8);
  }
  .drow__price {
    flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .drow__edit {
    flex: 0 0 auto;
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--accent);
  }
  .drow__del {
    flex: 0 0 auto;
    background: none;
    border: none;
    font: inherit;
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
  }
  .drow__del:hover {
    color: var(--color-berlin-red);
  }

  /* --- Categories management --------------------------------------------- */
  .cats {
    margin-block-start: var(--space-24);
    padding-block-start: var(--space-24);
    border-top: 1px solid var(--border-subtle);
  }
  .cats__title {
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    padding-block-end: var(--space-16);
  }
  .cats__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .crow {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    flex-wrap: wrap;
  }
  .crow__edit,
  .catnew {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .catnew {
    margin-block-start: var(--space-24);
    flex-wrap: wrap;
  }
  .crow__name {
    padding: var(--space-8) var(--space-12);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-strong);
    font: inherit;
    /* ≥16px so iOS doesn't zoom-and-reflow on focus (body font is 15px). */
    font-size: max(1rem, var(--fs-body));
  }
  .crow__sort {
    width: 4.5rem;
    padding: var(--space-8) var(--space-12);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-strong);
    font: inherit;
    /* ≥16px so iOS doesn't zoom-and-reflow on focus (body font is 15px). */
    font-size: max(1rem, var(--fs-body));
  }
  .crow__name:focus,
  .crow__sort:focus {
    outline: none;
    border-color: var(--accent);
  }
  .crow__save,
  .crow__del {
    background: none;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font: inherit;
    font-size: var(--fs-caption);
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    padding: var(--space-8) var(--space-16);
    cursor: pointer;
  }
  .crow__save:hover {
    color: var(--text-strong);
    border-color: var(--accent);
  }
  .crow__del:hover:not(:disabled) {
    color: var(--color-berlin-red);
    border-color: var(--color-berlin-red);
  }
  .crow__del:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .crow__count {
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }
  .catnew__add {
    background: var(--accent);
    color: var(--color-warm-black);
    border: none;
    font: inherit;
    font-size: var(--fs-caption);
    text-transform: uppercase;
    letter-spacing: var(--tracking-nav);
    padding: var(--space-8) var(--space-24);
    cursor: pointer;
  }
</style>
