---
/**
 * Add a dish (manager). Renders the shared DishForm; posts to
 * /api/admin/items/new.
 */
import AppLayout from "../../../layouts/AppLayout.astro";
import DishForm from "../../../components/order/DishForm.astro";
import { getCategoryOptions } from "../../../lib/menu/admin";

export const prerender = false;

const { supabase } = Astro.locals;
const categories = await getCategoryOptions(supabase);
const err = Astro.url.searchParams.get("err");
---

<AppLayout title="Add dish — Berlin">
  <main class="admin-form">
    <header class="admin-form__bar">
      <a class="admin-form__back" href="/admin">← Menu manager</a>
      <h1 class="admin-form__title">Add a dish</h1>
    </header>

    {err && <p class="flash flash--err" role="alert">{err}</p>}

    {categories.length === 0 ? (
      <p class="admin-form__note">Create a category first — then you can add dishes to it.</p>
    ) : (
      <DishForm categories={categories} action="/api/admin/items/new" submitLabel="Add dish" />
    )}
  </main>
</AppLayout>

<style>
  .admin-form {
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-32) var(--gutter) var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .admin-form__bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-block-end: var(--space-24);
    border-bottom: 1px solid var(--border-subtle);
  }
  .admin-form__back {
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .admin-form__back:hover {
    color: var(--text-strong);
  }
  .admin-form__title {
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    color: var(--text-strong);
  }
  .admin-form__note {
    color: var(--text-muted);
  }
  .flash--err {
    padding: var(--space-12) var(--space-16);
    font-size: var(--fs-caption);
    border: 1px solid var(--color-berlin-red);
    background: color-mix(in srgb, var(--color-berlin-red) 14%, transparent);
    color: var(--text-strong);
  }
</style>
