---
/**
 * Edit a dish (manager). Shared DishForm posts to /api/admin/items/[id]; a
 * separate form deletes it (kept out of the edit form since forms can't nest).
 */
import AppLayout from "../../../layouts/AppLayout.astro";
import DishForm from "../../../components/order/DishForm.astro";
import { getItem, getCategoryOptions } from "../../../lib/menu/admin";

export const prerender = false;

const { supabase } = Astro.locals;
const id = Astro.params.id ?? "";
const item = await getItem(supabase, id);
if (!item) Astro.response.status = 404;

const categories = item ? await getCategoryOptions(supabase) : [];
const err = Astro.url.searchParams.get("err");
---

<AppLayout title={item ? `Edit ${item.name} — Berlin` : "Dish not found — Berlin"}>
  <main class="admin-form">
    <header class="admin-form__bar">
      <a class="admin-form__back" href="/admin">← Menu manager</a>
      <h1 class="admin-form__title">{item ? "Edit dish" : "Dish not found"}</h1>
    </header>

    {err && <p class="flash flash--err" role="alert">{err}</p>}

    {!item ? (
      <p class="admin-form__note">That dish no longer exists.</p>
    ) : (
      <>
        <DishForm
          item={item}
          categories={categories}
          action={`/api/admin/items/${id}`}
          submitLabel="Save changes"
          isEdit
        />
        <form method="post" action={`/api/admin/items/${id}`} class="delete">
          <input type="hidden" name="action" value="delete" />
          <button type="submit" class="delete__btn">Delete dish</button>
        </form>
      </>
    )}
  </main>
</AppLayout>

<style>
  .admin-form {
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-32) var(--gutter) var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .admin-form__bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-block-end: var(--space-24);
    border-bottom: 1px solid var(--border-subtle);
  }
  .admin-form__back {
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .admin-form__back:hover {
    color: var(--text-strong);
  }
  .admin-form__title {
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    color: var(--text-strong);
  }
  .admin-form__note {
    color: var(--text-muted);
  }
  .flash--err {
    padding: var(--space-12) var(--space-16);
    font-size: var(--fs-caption);
    border: 1px solid var(--color-berlin-red);
    background: color-mix(in srgb, var(--color-berlin-red) 14%, transparent);
    color: var(--text-strong);
  }
  .delete {
    padding-block-start: var(--space-16);
    border-top: 1px solid var(--border-subtle);
  }
  .delete__btn {
    background: none;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font: inherit;
    min-height: 2.5rem;
    padding-inline: var(--space-24);
    text-transform: uppercase;
    letter-spacing: var(--tracking-nav);
    cursor: pointer;
  }
  .delete__btn:hover {
    color: var(--text-strong);
    border-color: var(--color-berlin-red);
  }
</style>
