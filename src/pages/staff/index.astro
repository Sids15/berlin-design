---
/**
 * Staff console (Feature 4). A server looks up an order by its code, reviews it,
 * and confirms it — the confirm is what flips the customer's tracking page from
 * "Waiting" to "Order placed". Behind the auth middleware, so `locals.profile`
 * is guaranteed here. Reads through the authenticated client (RLS applies).
 */
import AppLayout from "../../layouts/AppLayout.astro";
import StationMasthead from "../../components/staff/StationMasthead.astro";
import PendingQueue from "../../components/order/PendingQueue.tsx";
import { getStaffOrder, getPendingOrders } from "../../lib/orders/staff";
import { formatINR } from "../../lib/money";
import "../../styles/staff.css";

export const prerender = false;

const { supabase, profile } = Astro.locals;
const params = Astro.url.searchParams;

const rawCode = (params.get("code") ?? "").trim().toUpperCase();
const ok = params.get("ok"); // "confirmed" | "cancelled" | "created"
const err = params.get("err");

const order = rawCode ? await getStaffOrder(supabase, rawCode) : null;
const notFound = rawCode !== "" && !order;

const canTake = profile!.role === "manager" || profile!.role === "server";
// The pending queue (notification) is only meaningful to roles that confirm.
const pending = canTake ? await getPendingOrders(supabase) : [];
const STATUS_LABEL: Record<string, string> = {
  pending: "Waiting to be confirmed",
  confirmed: "Confirmed",
  preparing: "Preparing",
  ready: "Ready",
  served: "Served",
  cancelled: "Cancelled",
};

function when(iso: string): string {
  try {
    return new Date(iso).toLocaleString("en-IN", {
      hour: "2-digit",
      minute: "2-digit",
      day: "numeric",
      month: "short",
    });
  } catch {
    return "";
  }
}
---

<AppLayout title="Staff console — Berlin">
  <main class="st-shell desk">
    <StationMasthead title="Order desk">
      <div class="st-actions" slot="actions">
        <nav class="st-nav" aria-label="Staff sections">
          {profile!.role === "manager" && <a class="st-navlink" href="/admin">Menu</a>}
          {canTake && <a class="st-navlink" href="/staff/tabs">Tabs</a>}
          {canTake && <a class="st-navlink" href="/staff/tables">QR codes</a>}
          {canTake && (
            <a class="st-cta" href="/staff/new">
              <span aria-hidden="true">＋</span> Build order
            </a>
          )}
        </nav>
        <span class="st-actions__div" aria-hidden="true"></span>
        <span class="st-pass">
          {profile!.name && profile!.name.trim().toLowerCase() !== profile!.role && (
            <span class="st-pass__name">{profile!.name}</span>
          )}
          <span class="st-pass__role">{profile!.role}</span>
        </span>
        <form method="post" action="/api/auth/logout">
          <button class="st-signout" type="submit">Sign out</button>
        </form>
      </div>
    </StationMasthead>

    {canTake && <PendingQueue client:load initialOrders={pending} />}

    <form class={`lookup st-rise-2 ${!order ? "lookup--hero" : ""}`} method="get" action="/staff">
      <label class="lookup__label" for="code">Look up an order</label>
      <div class="lookup__row">
        <div class="lookup__field">
          <input
            class="lookup__input"
            id="code"
            name="code"
            value={rawCode}
            placeholder="3FTBUB"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            autofocus
          />
        </div>
        <button class="lookup__go st-btn st-btn--primary" type="submit">
          <span>Look up</span>
          <svg class="st-btn__arrow" width="30" height="8" viewBox="0 0 30 8" fill="none" aria-hidden="true">
            <path d="M0 4h28M28 4l-5-3.25M28 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
          </svg>
        </button>
      </div>
      <p class="lookup__hint">Read the six-character code from the guest's screen or QR.</p>
    </form>

    {ok && (
      <p class="st-alert st-alert--ok st-rise" role="status">
        {ok === "confirmed"
          ? `Order ${rawCode} confirmed — the table has been told.`
          : ok === "created"
            ? `Order ${rawCode} created and confirmed.`
            : `Order ${rawCode} cancelled.`}
      </p>
    )}
    {err && <p class="st-alert st-alert--error st-rise" role="alert">{err}</p>}

    {notFound && (
      <p class="st-empty">No order found for <strong>{rawCode}</strong>. Check the code and try again.</p>
    )}

    {order && (
      <div class="ticket st-rise-2">
        <section class="docket" aria-label={`Order ${order.code}`}>
          <header class="docket__head">
            <div class="docket__ident">
              <p class="docket__label">Docket</p>
              <p class="docket__code">{order.code}</p>
              <p class="docket__meta">
                {order.table_label ? `Table ${order.table_label}` : "No table"} ·
                {order.source === "customer" ? " Guest order" : " Server order"} ·
                {" "}{when(order.created_at)}
              </p>
            </div>
            <span class={`badge badge--${order.status}`}>{STATUS_LABEL[order.status]}</span>
          </header>

          <ul class="docket__lines">
            {order.items.map((line) => (
              <li class="docket__line">
                <span class="docket__qty">{line.qty}×</span>
                <span class="docket__name">
                  {line.name}
                  {line.notes && <span class="docket__lnote">{line.notes}</span>}
                </span>
                <span class="docket__price">{formatINR(line.price * line.qty)}</span>
              </li>
            ))}
          </ul>

          <div class="docket__total">
            <span>Subtotal</span>
            <span>{formatINR(order.subtotal)}</span>
          </div>

          {order.notes && <p class="docket__note">Note — {order.notes}</p>}

          <div class="docket__links">
            <a class="docket__link" href={`/staff/orders/${order.code}/slip`}>Print slip</a>
            {order.tab_id && <a class="docket__link" href={`/staff/tabs/${order.tab_id}`}>Bill · Table {order.table_label}</a>}
          </div>

          {canTake && order.status === "pending" && (
            <div class="actions">
              <form method="post" action={`/api/staff/orders/${order.code}`}>
                <input type="hidden" name="action" value="confirm" />
                <button class="st-btn st-btn--primary actions__confirm" type="submit">
                  <span>Confirm order</span>
                  <svg class="st-btn__arrow" width="30" height="8" viewBox="0 0 30 8" fill="none" aria-hidden="true">
                    <path d="M0 4h28M28 4l-5-3.25M28 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
                  </svg>
                </button>
              </form>
              <form method="post" action={`/api/staff/orders/${order.code}`}>
                <input type="hidden" name="action" value="cancel" />
                <button class="st-btn st-btn--ghost" type="submit">Cancel</button>
              </form>
            </div>
          )}

          {canTake && order.status === "confirmed" && (
            <div class="actions">
              <p class="actions__done">Confirmed. The kitchen board will pick it up.</p>
              <form method="post" action={`/api/staff/orders/${order.code}`}>
                <input type="hidden" name="action" value="cancel" />
                <button class="st-btn st-btn--ghost" type="submit">Cancel</button>
              </form>
            </div>
          )}
        </section>
        <div class="docket__perf" aria-hidden="true"></div>
      </div>
    )}
  </main>
</AppLayout>

<style>
  /* --- Lookup ------------------------------------------------------------- */
  .lookup {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .lookup--hero {
    align-items: center;
    text-align: center;
    padding-block: clamp(var(--space-16), 3vh, var(--space-32));
  }
  .lookup__label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .lookup__row {
    display: flex;
    align-items: flex-end;
    gap: var(--space-16);
  }
  .lookup--hero .lookup__row {
    width: 100%;
    max-width: 32rem;
  }
  .lookup__field {
    position: relative;
    flex: 1 1 auto;
  }
  .lookup__field::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }
  .lookup__field:focus-within::after {
    transform: scaleX(1);
  }
  .lookup__input {
    width: 100%;
    padding: var(--space-12) 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-strong);
    color: var(--text-strong);
    font: inherit;
    font-family: var(--font-display);
    font-size: var(--fs-heading-m);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 0;
  }
  .lookup__input::placeholder {
    color: var(--text-muted);
    opacity: 0.45;
  }
  .lookup__input:focus {
    outline: none;
  }
  .lookup__go {
    flex: 0 0 auto;
  }
  .lookup__hint {
    max-width: none;
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  /* --- The docket — a kitchen pass slip (the signature) ------------------- */
  .ticket {
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.35));
  }
  .docket {
    background: var(--bg-elevated);
    border-top: 2px solid var(--accent);
    padding: clamp(var(--space-24), 4vw, var(--space-40));
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  /* Torn, perforated bottom edge — this is a printed docket. */
  .docket__perf {
    height: 0.75rem;
    background: var(--bg-elevated);
    -webkit-mask: radial-gradient(0.42rem at 50% 100%, transparent 96%, #000)
      0 100% / 0.9rem 0.75rem repeat-x;
    mask: radial-gradient(0.42rem at 50% 100%, transparent 96%, #000)
      0 100% / 0.9rem 0.75rem repeat-x;
  }

  .docket__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-16);
    padding-block-end: var(--space-24);
    border-bottom: 1px dashed var(--accent-muted);
  }
  .docket__label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .docket__code {
    margin-block-start: var(--space-8);
    font-family: var(--font-display);
    font-size: var(--fs-heading-l);
    line-height: 1;
    letter-spacing: 0.12em;
    color: var(--text-strong);
  }
  .docket__meta {
    margin-block-start: var(--space-12);
    max-width: none;
    font-size: var(--fs-caption);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .badge {
    flex: 0 0 auto;
    padding: var(--space-4) var(--space-12);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .badge--pending {
    border-color: var(--accent);
    color: var(--accent);
  }
  .badge--confirmed,
  .badge--preparing,
  .badge--ready,
  .badge--served {
    border-color: #4c8b4a;
    color: #6fae5c;
  }
  .badge--cancelled {
    border-color: var(--color-berlin-red);
    color: #c76b60;
  }

  .docket__lines {
    display: flex;
    flex-direction: column;
  }
  .docket__line {
    display: flex;
    align-items: baseline;
    gap: var(--space-16);
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--border-subtle);
  }
  .docket__line:first-child {
    padding-block-start: 0;
  }
  .docket__qty {
    flex: 0 0 auto;
    min-width: 2ch;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .docket__name {
    flex: 1 1 auto;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .docket__lnote {
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }
  .docket__price {
    flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .docket__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-16);
    padding-block-start: var(--space-4);
    font-size: var(--fs-body-l);
    color: var(--text-strong);
  }
  .docket__total span:first-child {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .docket__total span:last-child {
    font-family: var(--font-display);
    font-size: var(--fs-heading-m);
    font-variant-numeric: tabular-nums;
  }
  .docket__note {
    max-width: none;
    padding: var(--space-12) var(--space-16);
    font-size: var(--fs-caption);
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    border-inline-start: 2px solid var(--accent-muted);
  }
  .docket__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-24);
  }
  .docket__link {
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--accent-muted);
    padding-block-end: var(--space-4);
    transition: color 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }
  .docket__link:hover {
    color: var(--text-strong);
    border-color: var(--accent);
  }

  /* --- Actions ------------------------------------------------------------ */
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding-block-start: var(--space-24);
    border-top: 1px dashed var(--accent-muted);
    flex-wrap: wrap;
  }
  .actions__confirm {
    min-width: 15rem;
  }
  .actions__done {
    flex: 1 1 12rem;
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  @media (max-width: 34rem) {
    .lookup__row {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-24);
    }
    .lookup__go {
      width: 100%;
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
    }
    .actions__confirm {
      min-width: 0;
    }
  }
</style>
