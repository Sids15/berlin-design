---
/**
 * Table QR codes (Feature: table provisioning). Staff enter table labels and
 * get a printable sheet of per-table QR codes, each encoding
 * <origin>/menu?table=<label> — scanning fills the table automatically, so the
 * customer never types it. Behind the auth middleware (any staff). QR SVGs are
 * generated server-side with the `qrcode` lib. @media print hides the chrome.
 */
import QRCode from "qrcode";
import AppLayout from "../../../layouts/AppLayout.astro";

export const prerender = false;

/** Parse "1-12, patio, 14" into distinct labels; expand N-M integer ranges. */
function parseTables(raw: string): string[] {
  const out: string[] = [];
  for (const tok of raw.split(/[\s,]+/).filter(Boolean)) {
    const m = tok.match(/^(\d+)-(\d+)$/);
    if (m) {
      let a = parseInt(m[1], 10);
      let b = parseInt(m[2], 10);
      if (a > b) [a, b] = [b, a];
      for (let i = a; i <= b && out.length < 100; i++) out.push(String(i));
    } else {
      out.push(tok);
    }
  }
  return [...new Set(out)].slice(0, 100);
}

const raw = Astro.url.searchParams.get("tables") ?? "";
const labels = parseTables(raw);
const origin = Astro.url.origin;

const cards = await Promise.all(
  labels.map(async (label) => {
    const url = `${origin}/menu?table=${encodeURIComponent(label)}`;
    const svg = await QRCode.toString(url, {
      type: "svg",
      margin: 1,
      color: { dark: "#171512", light: "#ffffff" },
    });
    return { label, url, svg };
  }),
);
---

<AppLayout title="Table QR codes — Berlin">
  <main class="qr">
    <header class="qr__bar no-print">
      <div>
        <p class="qr__eyebrow">Berlin · Staff</p>
        <h1 class="qr__title">Table QR codes</h1>
      </div>
      <a class="qr__back" href="/staff">← Order desk</a>
    </header>

    <form class="qr__form no-print" method="get" action="/staff/tables">
      <label class="qr__label" for="tables">Tables</label>
      <div class="qr__row">
        <input
          class="qr__input"
          id="tables"
          name="tables"
          value={raw}
          placeholder="e.g. 1-12, patio, bar-3"
          autocomplete="off"
        />
        <button class="qr__go" type="submit">Generate</button>
      </div>
      <p class="qr__hint">
        Comma- or space-separated. Use a range like <code>1-12</code>. Each code opens the
        menu with that table pre-set.
      </p>
    </form>

    {cards.length > 0 && (
      <div class="qr__actions no-print">
        <span class="qr__count">{cards.length} {cards.length === 1 ? "code" : "codes"}</span>
        <button id="print-btn" type="button" class="qr__print">Print sheet</button>
      </div>
    )}

    {cards.length === 0 ? (
      <p class="qr__empty no-print">Enter table labels above to generate printable QR codes.</p>
    ) : (
      <div class="qr__grid">
        {cards.map((c) => (
          <article class="qrcard">
            <p class="qrcard__label">Table {c.label}</p>
            <div class="qrcard__code" set:html={c.svg} />
            <p class="qrcard__brand">Scan to order · Berlin</p>
          </article>
        ))}
      </div>
    )}
  </main>
</AppLayout>

<script>
  document.getElementById("print-btn")?.addEventListener("click", () => window.print());
</script>

<style>
  .qr {
    max-width: var(--container-xl);
    margin-inline: auto;
    padding: var(--space-32) var(--gutter) var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .qr__bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-16);
    padding-block-end: var(--space-24);
    border-bottom: 1px solid var(--border-subtle);
  }
  .qr__eyebrow {
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .qr__title {
    margin-block-start: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    color: var(--text-strong);
  }
  .qr__back {
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .qr__back:hover {
    color: var(--text-strong);
  }
  .qr__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .qr__label {
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .qr__row {
    display: flex;
    gap: var(--space-12);
  }
  .qr__input {
    flex: 1 1 auto;
    padding: var(--space-12) var(--space-16);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-strong);
    font: inherit;
  }
  .qr__input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .qr__go {
    flex: 0 0 auto;
    padding-inline: var(--space-24);
    background: var(--accent);
    color: var(--color-warm-black);
    border: none;
    font: inherit;
    text-transform: uppercase;
    letter-spacing: var(--tracking-nav);
    cursor: pointer;
  }
  .qr__hint {
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }
  .qr__hint code {
    color: var(--text);
  }
  .qr__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
  }
  .qr__count {
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }
  .qr__print {
    min-height: 2.5rem;
    padding-inline: var(--space-24);
    background: var(--accent);
    color: var(--color-warm-black);
    border: none;
    font: inherit;
    text-transform: uppercase;
    letter-spacing: var(--tracking-nav);
    cursor: pointer;
  }
  .qr__empty {
    padding-block: var(--space-48);
    text-align: center;
    color: var(--text-muted);
  }
  .qr__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-16);
  }
  .qrcard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-24);
    background: var(--color-ivory);
    color: var(--color-warm-black);
    text-align: center;
  }
  .qrcard__label {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
  }
  .qrcard__code {
    width: 9rem;
    height: 9rem;
  }
  .qrcard__code :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .qrcard__brand {
    font-size: var(--fs-caption);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: #5b544a;
  }

  @media print {
    :global(body) {
      background: #fff !important;
    }
    .qr {
      max-width: none;
      padding: 0;
      gap: 0;
    }
    .no-print {
      display: none !important;
    }
    .qr__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }
    .qrcard {
      background: #fff;
      color: #000;
      border: 1px solid #ccc;
      break-inside: avoid;
    }
    .qrcard__brand {
      color: #333;
    }
  }
</style>
