---
/**
 * Order tracking (Feature 3). A customer lands here right after placing an
 * order. It shows their code + QR (to show a server) and a live status that
 * flips "Waiting" → "Order placed" once a server accepts it. Server-rendered:
 * reads the order by code via the admin client (customers have no direct DB
 * access), then the OrderStatus island polls for the state change.
 */
import QRCode from "qrcode";
import AppLayout from "../../layouts/AppLayout.astro";
import OrderStatus from "../../components/order/OrderStatus.tsx";
import { getTrackedOrder } from "../../lib/orders/track";
import { formatINR } from "../../lib/money";

export const prerender = false;

const code = (Astro.params.code ?? "").toUpperCase();
const order = await getTrackedOrder(code);

if (!order) {
  Astro.response.status = 404;
}

// A QR of the plain code — staff scan or key it in to pull up the order.
const qrSvg = order
  ? await QRCode.toString(order.code, {
      type: "svg",
      margin: 1,
      color: { dark: "#171512", light: "#e9e2d4" },
    })
  : "";
---

<AppLayout title={order ? `Order ${order.code} — Berlin` : "Order not found — Berlin"}>
  {
    !order ? (
      <main class="track track--missing">
        <p class="track__eyebrow">Berlin · Haus de Gourmet</p>
        <h1 class="track__title">Order not found</h1>
        <p class="track__note">
          We couldn't find an order for that code. Please check it, or place a new
          order from the menu.
        </p>
        <a class="track__link" href="/menu">Back to the menu</a>
      </main>
    ) : (
      <main class="track">
        <header class="track__head">
          <p class="track__eyebrow">Berlin · Haus de Gourmet</p>
          <h1 class="track__title">Your order</h1>
          <p class="track__sub">Keep this ticket until your order reaches the table.</p>
          <div class="track__rule" aria-hidden="true"><span class="track__mark">✦</span></div>
          {order.table_label && <p class="track__table">Table {order.table_label}</p>}
        </header>

        <OrderStatus client:load code={order.code} initialState={order.state} />

        <div class="pass-wrap">
          <section class="pass" aria-label="Your order code">
            <div class="pass__qr" set:html={qrSvg} />
            <div class="pass__meta">
              <p class="pass__label">Order code</p>
              <p class="pass__code">{order.code}</p>
              <p class="pass__hint">Show this to a server to confirm your order.</p>
            </div>
          </section>
          <div class="pass__perf" aria-hidden="true"></div>
        </div>

        <section class="summary" aria-label="Order summary">
          <h2 class="summary__title">Summary</h2>
          <ul class="summary__list">
            {order.items.map((line) => (
              <li class="summary__line">
                <span class="summary__qty">{line.qty}×</span>
                <span class="summary__name">{line.name}</span>
                <span class="summary__price">{formatINR(line.price * line.qty)}</span>
              </li>
            ))}
          </ul>
          <div class="summary__total">
            <span>Subtotal</span>
            <span>{formatINR(order.subtotal)}</span>
          </div>
          {order.notes && <p class="summary__notes">Note — {order.notes}</p>}
        </section>

        <nav class="track__links" aria-label="More">
          <a class="track__link" href="/orders">
            <span>See all your orders</span>
            <svg width="30" height="8" viewBox="0 0 30 8" fill="none" aria-hidden="true">
              <path d="M0 4h28M28 4l-5-3.25M28 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
            </svg>
          </a>
          <a
            class="track__link"
            href={order.table_label ? `/menu/${encodeURIComponent(order.table_label)}` : "/menu"}
          >
            <span>Order something more</span>
            <svg width="30" height="8" viewBox="0 0 30 8" fill="none" aria-hidden="true">
              <path d="M0 4h28M28 4l-5-3.25M28 4l-5 3.25" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
            </svg>
          </a>
        </nav>
      </main>
    )
  }
</AppLayout>

<style>
  .track {
    max-width: 37rem;
    margin-inline: auto;
    padding: clamp(var(--space-40), 8vw, var(--space-80)) var(--gutter) var(--space-80);
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }
  .track--missing {
    min-height: 100svh;
    justify-content: center;
    text-align: center;
  }
  .track__head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .track__eyebrow {
    font-family: var(--font-ui);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .track__title {
    margin-block-start: var(--space-16);
    font-family: var(--font-display);
    font-size: var(--fs-display-m);
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }
  .track__sub {
    margin: var(--space-16) auto 0;
    max-width: 24rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-body-l);
    line-height: 1.4;
    color: var(--text-muted);
  }
  /* A centred fleuron flanked by hairlines — the menu's carte device. */
  .track__rule {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-16);
    width: 12rem;
    margin: var(--space-32) auto 0;
    color: var(--accent);
  }
  .track__rule::before,
  .track__rule::after {
    content: "";
    height: 1px;
    background: var(--border-strong);
  }
  .track__mark {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    transform: translateY(-0.05em);
  }
  .track__table {
    margin-block-start: var(--space-24);
    padding: var(--space-8) var(--space-16);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent-muted);
  }
  .track__note {
    margin: 0 auto;
    color: var(--text-muted);
  }

  /* --- Status banner (OrderStatus island) -------------------------------- */
  .track :global(.status) {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding: var(--space-24);
    border: 1px solid var(--border-subtle);
    border-inline-start: 2px solid var(--accent);
    background: var(--bg-elevated);
  }
  .track :global(.status__pulse) {
    flex: 0 0 auto;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .track :global(.status--waiting .status__pulse) {
    animation: pulse 1.6s var(--ease-smooth) infinite;
  }
  .track :global(.status--placed) {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-elevated));
  }
  .track :global(.status--placed .status__pulse) {
    background: #4c8b4a;
  }
  .track :global(.status--cancelled .status__pulse) {
    background: var(--color-berlin-red);
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.7);
    }
  }
  .track :global(.status__title) {
    font-family: var(--font-display);
    font-size: var(--fs-heading-s);
    color: var(--text-strong);
    letter-spacing: 0;
  }
  .track :global(.status__note) {
    margin-block-start: var(--space-4);
    font-size: var(--fs-body);
    color: var(--text-muted);
  }

  /* --- Pass (code + QR) — an ivory boarding-pass with a torn edge --------- */
  .pass-wrap {
    filter: drop-shadow(0 20px 36px rgba(0, 0, 0, 0.35));
  }
  .pass {
    display: flex;
    align-items: center;
    gap: var(--space-32);
    padding: var(--space-32) var(--space-24);
    background: var(--color-ivory);
    color: var(--color-warm-black);
  }
  .pass__qr {
    flex: 0 0 auto;
    width: 8rem;
    height: 8rem;
    padding: var(--space-8);
    background: var(--color-ivory);
    border: 1px solid #cfc5b2;
  }
  .pass__qr :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .pass__label {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-champagne-muted);
  }
  .pass__code {
    margin-block-start: var(--space-8);
    font-family: var(--font-display);
    font-size: var(--fs-display-s);
    line-height: 1;
    letter-spacing: 0.12em;
    color: var(--color-warm-black);
  }
  .pass__hint {
    margin-block-start: var(--space-12);
    font-size: var(--fs-caption);
    color: #5b544a;
  }
  .pass__perf {
    height: 0.7rem;
    background: var(--color-ivory);
    -webkit-mask: radial-gradient(0.4rem at 50% 100%, transparent 96%, #000) 0 100% / 0.8rem 0.7rem repeat-x;
    mask: radial-gradient(0.4rem at 50% 100%, transparent 96%, #000) 0 100% / 0.8rem 0.7rem repeat-x;
  }

  /* --- Summary ------------------------------------------------------------ */
  .summary__title {
    font-family: var(--font-display);
    font-size: var(--fs-heading-m);
    color: var(--text-strong);
    padding-block-end: var(--space-16);
    border-bottom: 1px solid var(--border-subtle);
  }
  .summary__list {
    display: flex;
    flex-direction: column;
  }
  .summary__line {
    display: flex;
    align-items: baseline;
    gap: var(--space-16);
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--border-subtle);
  }
  .summary__qty {
    flex: 0 0 auto;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .summary__name {
    flex: 1 1 auto;
    color: var(--text);
  }
  .summary__price {
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .summary__total {
    display: flex;
    justify-content: space-between;
    padding-block-start: var(--space-16);
    font-size: var(--fs-body-l);
    color: var(--text-strong);
  }
  .summary__total span:last-child {
    font-variant-numeric: tabular-nums;
  }
  .summary__notes {
    margin-block-start: var(--space-12);
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  .track__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16) var(--space-32);
  }
  .track__link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--accent-muted);
    padding-block-end: var(--space-4);
    transition: color 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }
  .track__link svg {
    transition: transform 0.35s var(--ease-out);
  }
  .track__link:hover {
    color: var(--text-strong);
    border-color: var(--accent);
  }
  .track__link:hover svg {
    transform: translateX(4px);
  }
  .track--missing .track__link {
    align-self: center;
    margin-block-start: var(--space-24);
  }

  @media (max-width: 30rem) {
    .pass {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
