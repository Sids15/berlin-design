---
/**
 * Customer menu at /menu (no table) — e.g. someone browsing without scanning a
 * table QR. The per-table entry point is /menu/[table]. Back-compat: a legacy
 * ?table= still rides along.
 */
import AppLayout from "../../layouts/AppLayout.astro";
import MenuView from "../../components/order/MenuView.astro";

export const prerender = false;

const table = Astro.url.searchParams.get("table");
---

<AppLayout title="Menu — Berlin">
  <MenuView table={table} />
</AppLayout>
